    </div>

    <script>
      import "@material/web/icon/icon.js";
      import "@material/web/iconbutton/icon-button.js";
      import "@material/web/button/filled-button.js";
      import "@material/web/fab/fab.js";

      const REFRESH_MS = 60_000;
      const CAMERA_REFRESH_MS = 120_000;

      const fmt = (value: number | null, digits = 1): string =>
        value === null || value === undefined ? "--" : value.toFixed(digits);

      const setField = (name: string, value: string): void => {
        document.querySelectorAll<HTMLElement>(`[data-field="${name}"]`).forEach((el) => {
          el.textContent = value;
        });
      };

      const setStatus = (state: "live" | "error" | "idle"): void => {
        const dot = document.querySelector<HTMLElement>("[data-status]");
        if (!dot) return;
        dot.classList.toggle("live", state === "live");
        dot.classList.toggle("error", state === "error");
      };

      const updatedLabel = (seconds: number | null): string => {
        if (seconds === null) return "Actualizado recientemente";
        if (seconds < 60) return `Actualizado hace ${seconds} s`;
        return `Actualizado hace ${Math.round(seconds / 60)} min`;
      };

      const forecastDateLabel = (offsetDays: number | null): string => {
        if (typeof offsetDays !== "number") return "";
        try {
          const date = new Date(Date.now() + offsetDays * 86_400_000);
          return new Intl.DateTimeFormat("es-AR", {
            weekday: "short",
            day: "numeric",
            month: "short",
            timeZone: "America/Argentina/Buenos_Aires",
          }).format(date);
        } catch {
          return "";
        }
      };

      const getForecastChipIcon = (text: string): string => {
        const t = text.toLowerCase();
        if (t.includes("máx") || t.includes("mín")) return "device_thermostat";
        if (t.includes("viento")) return "air";
        if (t.includes("lluvia") || t.includes("precip") || t.includes("chaparron")) return "water_drop";
        if (t.includes("humedad")) return "humidity_mid";
        if (t.includes("uv")) return "sunny";
        return "info";
      };

      const setForecastCard = (forecast: Record<string, any> | undefined): void => {
        const parts: string[] = [];
        if (forecast?.period) {
          const when = forecastDateLabel(forecast.periodOffsetDays);
          parts.push(when ? `${forecast.period} · ${when}` : forecast.period);
        }
        setField("forecastPeriod", parts.join(" ") || "Próximas horas");

        const fallback = forecast?.summary ?? "";
        let condition = forecast?.condition ?? fallback;
        if (forecast?.period && condition.toLowerCase().startsWith(forecast.period.toLowerCase())) {
          condition = condition.slice(forecast.period.length).trim();
        }
        setField("forecastCondition", condition || "Sin pronóstico");

        const stationName = forecast?.stationName || "ClimaChivilcoy";
        const stationLoc = forecast?.stationLocation || "Barrio Alsina";
        setField("forecastStationSub", `Estación ${stationName} · ${stationLoc}`);
        setField("forecastNote", `Pronóstico derivado de sensores y modelo meteorológico de la estación ${stationName} (${stationLoc}).`);

        const avatarEl = document.querySelector<HTMLElement>('[data-field="forecastAvatar"]');
        const iconEl = document.querySelector<HTMLElement>('[data-field="forecastIcon"]');
        if (avatarEl && iconEl) {
          const iconName = forecast?.iconName || "wb_sunny";
          const iconTheme = forecast?.iconTheme || iconName;
          iconEl.textContent = iconName;
          avatarEl.className = `forecast-icon-avatar ${iconTheme}`;
        }

        const wrap = document.querySelector<HTMLElement>('[data-field="forecastDetails"]');
        if (wrap) {
          wrap.textContent = "";
          const details = Array.isArray(forecast?.details) ? forecast.details : [];
          for (const detail of details) {
            const chip = document.createElement("span");
            chip.className = "forecast-chip";
            const icon = document.createElement("md-icon");
            icon.textContent = getForecastChipIcon(detail);
            const textSpan = document.createElement("span");
            textSpan.textContent = detail;
            chip.appendChild(icon);
            chip.appendChild(textSpan);
            wrap.appendChild(chip);
          }
          wrap.hidden = details.length === 0;
        }
      };

      const agoShort = (seconds: number | null): string => {
        if (seconds === null) return "ahora";
        if (seconds < 60) return `hace ${seconds} s`;
        if (seconds < 3600) return `hace ${Math.round(seconds / 60)} min`;
        return `hace ${(seconds / 3600).toFixed(1)} h`;
      };

      let activeStationKey = "chivilcoy";
      let latestSources: Record<string, any>[] = [];

      const updateStationView = (key: string): void => {
        activeStationKey = key;
        const s = latestSources.find((src) => src.key === key) ?? latestSources[0];

        document.querySelectorAll<HTMLElement>("[data-station-key]").forEach((btn) => {
          const isActive = btn.dataset.stationKey === key;
          btn.classList.toggle("active", isActive);
          btn.setAttribute("aria-selected", String(isActive));
        });

        if (!s) return;

        const isInta = s.key === "inta";
        const isLw6eqg = s.key === "lw6eqg";
        const isIchivi27 = s.key === "ichivi27";
        const isIchivi4 = s.key === "ichivi4";
        const titleEl = document.querySelector<HTMLElement>('[data-station-detail="title"]');
        if (titleEl) titleEl.textContent = s.name;

        const subEl = document.querySelector<HTMLElement>('[data-station-detail="subtitle"]');
        if (subEl) {
          if (isInta) {
            subEl.textContent = "Polideportivo Municipal · Chivilcoy";
          } else if (isLw6eqg) {
            subEl.textContent = "Zona urbana · MeteoBridge v6.4";
          } else if (isIchivi27) {
            subEl.textContent = "Ruta Provincial 30 · AcuRite 5-in-1";
          } else if (isIchivi4) {
            subEl.textContent = "Barrio Sur · EasyWeather";
          } else {
            subEl.textContent = "Barrio Alsina · Meteobridge";
          }
        }

        const ageEl = document.querySelector<HTMLElement>('[data-station-detail="age"]');
        if (ageEl) ageEl.textContent = agoShort(s.updatedSeconds ?? null);

        const tempEl = document.querySelector<HTMLElement>('[data-station-detail="temp"]');
        if (tempEl) tempEl.textContent = fmt(s.temperature ?? null);

        const feelsEl = document.querySelector<HTMLElement>('[data-station-detail="feels"]');
        if (feelsEl) {
          const parts: string[] = [];
          if (s.feelsLike !== null && s.feelsLike !== undefined) {
            parts.push(`ST ${fmt(s.feelsLike, 0)}°`);
          }
          if (s.temperatureMax !== null && s.temperatureMax !== undefined) {
            parts.push(`Máx ${fmt(s.temperatureMax)}°`);
          }
          if (s.temperatureMin !== null && s.temperatureMin !== undefined) {
            parts.push(`Mín ${fmt(s.temperatureMin)}°`);
          }
          feelsEl.textContent = parts.length > 0 ? parts.join(" · ") : "Sin datos adicionales";
        }

        const humEl = document.querySelector<HTMLElement>('[data-station-detail="humidity"]');
        if (humEl) humEl.textContent = s.humidity !== null && s.humidity !== undefined ? String(s.humidity) : "--";

        const dewEl = document.querySelector<HTMLElement>('[data-station-detail="dewpoint"]');
        if (dewEl) {
          dewEl.textContent = s.dewpoint !== null && s.dewpoint !== undefined ? `Punto de rocío ${fmt(s.dewpoint)}°C` : "--";
        }

        const windEl = document.querySelector<HTMLElement>('[data-station-detail="wind"]');
        if (windEl) windEl.textContent = fmt(s.windAvg ?? null);

        const gustEl = document.querySelector<HTMLElement>('[data-station-detail="gust"]');
        if (gustEl) {
          gustEl.textContent = s.windGust !== null && s.windGust !== undefined ? `Ráfaga máx ${fmt(s.windGust)} km/h` : "Sin ráfaga registrada";
        }

        const presEl = document.querySelector<HTMLElement>('[data-station-detail="pressure"]');
        if (presEl) presEl.textContent = fmt(s.pressure ?? null, 0);

        const rainEl = document.querySelector<HTMLElement>('[data-station-detail="rain"]');
        if (rainEl) {
          rainEl.textContent = s.rainToday !== null && s.rainToday !== undefined ? `Lluvia hoy: ${fmt(s.rainToday)} mm` : "--";
        }

        const webAvatar = document.querySelector<HTMLElement>("[data-station-web-avatar]");
        if (webAvatar) {
          webAvatar.textContent = "";
          if (isInta) {
            const img = document.createElement("img");
            img.src = "/img/inta-favicon.ico";
            img.alt = "INTA";
            img.width = 22;
            img.height = 22;
            webAvatar.appendChild(img);
          } else if (isLw6eqg) {
            const img = document.createElement("img");
            img.src = "/img/lw6eqg-favicon.svg";
            img.alt = "LW6EQG";
            img.width = 22;
            img.height = 22;
            webAvatar.appendChild(img);
          } else if (isIchivi27) {
            const ic = document.createElement("md-icon");
            ic.textContent = "agriculture";
            webAvatar.appendChild(ic);
          } else if (isIchivi4) {
            const ic = document.createElement("md-icon");
            ic.textContent = "south";
            webAvatar.appendChild(ic);
          } else {
            const ic = document.createElement("md-icon");
            ic.textContent = "cloud";
            webAvatar.appendChild(ic);
          }
        }

        const webTitle = document.querySelector<HTMLElement>("[data-station-web-title]");
        if (webTitle) webTitle.textContent = `Sitio oficial de ${s.name}`;

        const webUrl = document.querySelector<HTMLElement>("[data-station-web-url]");
        if (webUrl) {
          try {
            const urlObj = new URL(s.url);
            webUrl.textContent = urlObj.hostname + (urlObj.pathname !== "/" ? urlObj.pathname : "");
          } catch {
            webUrl.textContent = s.url;
          }
        }

        const webBtn = document.querySelector<HTMLAnchorElement>("[data-station-web-btn]");
        if (webBtn) {
          webBtn.href = s.url;
          webBtn.title = `Abrir sitio oficial de ${s.name}`;
        }

        const mapCard = document.querySelector<HTMLAnchorElement>("[data-station-map-card]");
        const mapTitle = document.querySelector<HTMLElement>("[data-station-map-title]");
        const mapSub = document.querySelector<HTMLElement>("[data-station-map-sub]");
        if (mapCard) {
          if (isInta) {
            mapCard.hidden = false;
            mapCard.href = "https://www.google.com/maps/search/?api=1&query=-34.890556,-60.005833";
            if (mapTitle) mapTitle.textContent = "Polideportivo Municipal";
            if (mapSub) mapSub.textContent = "Coordenadas: -34.8906, -60.0058";
          } else if (isLw6eqg) {
            mapCard.hidden = false;
            mapCard.href = "https://www.google.com/maps/search/?api=1&query=-34.893675,-60.005533";
            if (mapTitle) mapTitle.textContent = "Estación LW6EQG";
            if (mapSub) mapSub.textContent = "Coordenadas: -34.8937, -60.0055";
          } else if (isIchivi27) {
            mapCard.hidden = false;
            mapCard.href = "https://www.google.com/maps/search/?api=1&query=-34.865,-60.003";
            if (mapTitle) mapTitle.textContent = "AFA Chivilcoy";
            if (mapSub) mapSub.textContent = "Coordenadas: -34.8650, -60.0030";
          } else if (isIchivi4) {
            mapCard.hidden = false;
            mapCard.href = "https://www.google.com/maps/search/?api=1&query=-34.92062,-60.001767";
            if (mapTitle) mapTitle.textContent = "Chivilcoy Zona Sur";
            if (mapSub) mapSub.textContent = "Coordenadas: -34.9206, -60.0018";
          } else if (s.key === "chivilcoy") {
            mapCard.hidden = false;
            mapCard.href = "https://www.google.com/maps/search/?api=1&query=-34.903034,-60.002193";
            if (mapTitle) mapTitle.textContent = "Barrio Alsina (Zona Este)";
            if (mapSub) mapSub.textContent = "Coordenadas: -34.9030, -60.0022";
          } else {
            mapCard.hidden = true;
          }
        }
      };

      document.querySelectorAll<HTMLElement>("[data-station-key]").forEach((btn) => {
        btn.addEventListener("click", () => {
          const key = btn.dataset.stationKey;
          if (key) updateStationView(key);
        });
      });

      const renderStations = (data: Record<string, any>): void => {
        const sources: Record<string, any>[] = Array.isArray(data.sources) ? data.sources : [];
        latestSources = sources;
        const count: number = data.stationCount ?? sources.length;
        const badge = document.querySelector<HTMLElement>('[data-field="stationBadge"]');
        if (badge) badge.hidden = count < 2;
        if (count >= 2) setField("stationBadgeText", `${count} estaciones`);
        setField("stationsNote", count >= 2 ? `${count} activas` : "");

        const pill = document.querySelector<HTMLElement>('[data-field="stationsBadgePill"]');
        if (pill) {
          pill.hidden = count === 0;
          const countEl = pill.querySelector<HTMLElement>('[data-field="stationsBadgeCount"]');
          if (countEl) countEl.textContent = count >= 2 ? `${count} en línea` : `${count} en línea`;
        }

        for (const s of sources) {
          const tabTemp = document.querySelector<HTMLElement>(`[data-station-tab-temp="${s.key}"]`);
          if (tabTemp) {
            tabTemp.textContent = s.temperature !== null && s.temperature !== undefined ? `${fmt(s.temperature)}°` : "--";
          }
        }

        if (!sources.some((s) => s.key === activeStationKey) && sources.length > 0) {
          activeStationKey = sources[0].key;
        }

        updateStationView(activeStationKey);
      };

      const smnToggleBtn = document.querySelector<HTMLButtonElement>("[data-smn-toggle]");
      const smnInstEl = document.querySelector<HTMLElement>("[data-smn-instructions]");
      if (smnToggleBtn && smnInstEl) {
        smnToggleBtn.addEventListener("click", () => {
          const isHidden = smnInstEl.hidden;
          smnInstEl.hidden = !isHidden;
          smnToggleBtn.classList.toggle("open", isHidden);
        });
      }

      const renderAlerts = (alerts: any[]): void => {
        const card = document.querySelector<HTMLElement>("[data-smn-card]");
        const activeAlerts = Array.isArray(alerts) ? alerts.filter((a) => a && a.level !== "verde") : [];

        if (activeAlerts.length === 0) {
          if (card) card.hidden = true;
          return;
        }

        if (!card) return;

        card.hidden = false;
        const alert = activeAlerts[0];

        card.classList.remove("level-amarillo", "level-naranja", "level-rojo");
        card.classList.add(`level-${alert.level}`);

        const badge = card.querySelector<HTMLElement>("[data-smn-badge]");
        if (badge) {
          badge.textContent = alert.type === "corto_plazo" ? "Aviso a Corto Plazo" : `Alerta ${alert.level.toUpperCase()}`;
          badge.style.setProperty("--smn-badge-bg", alert.levelColor);
          badge.style.setProperty("--smn-badge-color", alert.level === "amarillo" ? "#000" : "#fff");
        }

        const titleEl = card.querySelector<HTMLElement>("[data-smn-title]");
        if (titleEl) titleEl.textContent = alert.title || alert.event;

        const descEl = card.querySelector<HTMLElement>("[data-smn-desc]");
        if (descEl) descEl.textContent = alert.description ?? "";

        const timeEl = card.querySelector<HTMLElement>("[data-smn-time]");
        if (timeEl) {
          const parts: string[] = [];
          if (alert.timeFrame) parts.push(`Período: ${alert.timeFrame}`);
          if (alert.startsAt) {
            try {
              const d = new Date(alert.startsAt);
              parts.push(`Inicio: ${d.toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" })}`);
            } catch {}
          }
          if (alert.expiresAt) {
            try {
              const d = new Date(alert.expiresAt);
              parts.push(`Hasta: ${d.toLocaleTimeString("es-AR", { hour: "2-digit", minute: "2-digit" })}`);
            } catch {}
          }
          timeEl.textContent = parts.join(" · ");
        }

        if (smnInstEl && smnToggleBtn) {
          if (alert.instructions) {
            smnInstEl.textContent = alert.instructions;
            smnToggleBtn.hidden = false;
          } else {
            smnInstEl.hidden = true;
            smnToggleBtn.hidden = true;
          }
        }
      };

      const renderSmnForecast = (items: any[] | undefined): void => {
        const container = document.querySelector<HTMLElement>("[data-smn-forecast-container]");
        const list = document.querySelector<HTMLElement>("[data-smn-forecast-list]");
        if (!container || !list) return;

        const validItems = Array.isArray(items) ? items : [];
        if (validItems.length === 0) {
          container.hidden = true;
          return;
        }

        container.hidden = false;
        list.textContent = "";

        for (const item of validItems) {
          const row = document.createElement("div");
          row.className = "m3-forecast-row";

          // Col 1: Día y Fecha
          const dayCol = document.createElement("div");
          dayCol.className = "m3-forecast-day-col";

          const dayName = document.createElement("span");
          dayName.className = "m3-forecast-day-name";
          dayName.textContent = item.dayName || "--";

          const dayDate = document.createElement("span");
          dayDate.className = "m3-forecast-day-date";
          dayDate.textContent = item.dateLabel || "";

          dayCol.appendChild(dayName);
          if (item.dateLabel) dayCol.appendChild(dayDate);

          // Col 2: Icono Google Weather (FILL: 1) + badge de lluvia si > 0%
          const iconCol = document.createElement("div");
          iconCol.className = "m3-forecast-icon-col";

          const iconName = item.icon || "wb_sunny";
          const iconEl = document.createElement("md-icon");
          iconEl.className = `m3-weather-icon ${iconName}`;
          iconEl.textContent = iconName;
          iconCol.appendChild(iconEl);

          const rainText =
            item.rainProbLabel ||
            (typeof item.rainProb === "number" && item.rainProb > 0 ? `${item.rainProb}%` : null);
          if (rainText && rainText !== "0%") {
            const rainProb = document.createElement("span");
            rainProb.className = "m3-forecast-rain-prob";
            rainProb.innerHTML = `<md-icon>water_drop</md-icon>${rainText}`;
            iconCol.appendChild(rainProb);
          }

          // Col 3: Condición climática y Viento sutil
          const infoCol = document.createElement("div");
          infoCol.className = "m3-forecast-info-col";

          const condSpan = document.createElement("span");
          condSpan.className = "m3-forecast-cond";
          condSpan.textContent = item.condition || item.description || "";
          infoCol.appendChild(condSpan);

          const windLabel =
            item.wind ||
            (typeof item.windSpeed === "number" && item.windSpeed > 0
              ? `${item.windSpeed} km/h${item.windDirection ? ` ${item.windDirection}` : ""}`
              : null);
          if (windLabel) {
            const windSpan = document.createElement("span");
            windSpan.className = "m3-forecast-wind";
            windSpan.innerHTML = `<md-icon>air</md-icon>${windLabel}`;
            infoCol.appendChild(windSpan);
          }

          // Col 4: Temperaturas mínima y máxima
          const barCol = document.createElement("div");
          barCol.className = "m3-forecast-bar-col";

          const minVal = typeof item.tempMin === "number" ? item.tempMin : null;
          const maxVal = typeof item.tempMax === "number" ? item.tempMax : null;

          const minSpan = document.createElement("span");
          minSpan.className = "m3-temp-val min";
          minSpan.textContent = minVal !== null ? `${fmt(minVal, 0)}°` : "--";

          const maxSpan = document.createElement("span");
          maxSpan.className = "m3-temp-val max";
          maxSpan.textContent = maxVal !== null ? `${fmt(maxVal, 0)}°` : "--";

          barCol.appendChild(minSpan);
          barCol.appendChild(maxSpan);

          row.appendChild(dayCol);
          row.appendChild(iconCol);
          row.appendChild(infoCol);
          row.appendChild(barCol);

          list.appendChild(row);
        }
      };

      const render = (data: Record<string, any>): void => {
        setField("temperature", fmt(data.temperature));
        setField("feelsLike", fmt(data.feelsLike, 0));
        setField("temperatureMax", fmt(data.temperatureMax));
        setField("temperatureMin", fmt(data.temperatureMin));
        setField("humidity", data.humidity === null ? "--" : String(data.humidity));
        setField("humidityMax", data.humidityMax === null ? "--" : String(data.humidityMax));
        setField("humidityMin", data.humidityMin === null ? "--" : String(data.humidityMin));
        setField("dewpoint", fmt(data.dewpoint));
        setField("dewpointTrend", data.dewpointTrend ?? "--");
        setField("pressure", data.pressure === null ? "--" : String(data.pressure));
        setField("pressureTrend", data.pressureTrend ?? "--");
        setField("windAvg", fmt(data.windAvg));
        setField("windMax", fmt(data.windMax));
        setField("windRun", fmt(data.windRun, 0));
        setField("rainToday", fmt(data.rainToday));
        setField("rainMonth", fmt(data.rainMonth));
        setField("rainRate", fmt(data.rainRate));
        setField("sunrise", data.sunrise ?? "--");
        setField("sunset", data.sunset ?? "--");
        setField("daylight", data.daylight ? `${data.daylight} h` : "--");
        setField("moonPhase", data.moonPhase ?? "--");
        setField("moonLuminance", fmt(data.moonLuminance, 0));
        setForecastCard(data.forecast);
        const heroIconEl = document.querySelector<HTMLElement>('[data-field="heroIcon"]');
        const heroAvatarEl = document.querySelector<HTMLElement>('[data-field="heroAvatar"]');
        if (heroIconEl && heroAvatarEl) {
          const iconName = data.forecast?.iconName || "wb_sunny";
          const iconTheme = data.forecast?.iconTheme || iconName;
          heroIconEl.textContent = iconName;
          heroAvatarEl.className = `hero-icon-wrap ${iconTheme}`;
        }
        renderStations(data);
        renderAlerts(data.alerts);
        renderSmnForecast(data.smnForecast);

        setField("updated", updatedLabel(data.sourceUpdatedSeconds));
      };

      const offlineBanner = document.querySelector<HTMLElement>("[data-offline]");
      const showOffline = (offline: boolean): void => {
        if (offlineBanner) offlineBanner.hidden = !offline;
      };

      const load = async (): Promise<void> => {
        try {
          const response = await fetch("/api/current", {
            headers: { Accept: "application/json" },
            cache: "no-store",
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          render(await response.json());
          setStatus("live");
          showOffline(false);
        } catch {
          const offline = navigator.onLine === false;
          setStatus("error");
          showOffline(offline);
          setField(
            "updated",
            offline ? "Sin conexión a internet" : "No se pudo conectar con la estación",
          );
        }
      };

      const webcamCard = document.querySelector<HTMLElement>("[data-webcam-card]");
      const webcamImg = document.querySelector<HTMLImageElement>("[data-webcam-img]");
      const webcamLoading = document.querySelector<HTMLElement>("[data-webcam-loading]");
      const webcamZoom = document.querySelector<HTMLElement>("[data-webcam-zoom]");
      const webcamRefreshBtn = document.querySelector<HTMLElement>("[data-webcam-refresh]");
      const lightbox = document.querySelector<HTMLElement>("[data-lightbox]");
      const lightboxImg = document.querySelector<HTMLImageElement>("[data-lightbox-img]");
      const lightboxClose = document.querySelector<HTMLElement>("[data-lightbox-close]");
      const lightboxRefresh = document.querySelector<HTMLElement>("[data-lightbox-refresh]");
      let webcamLoaded = false;
      let webcamTimer: number | null = null;

      const webcamLabel = (): void => {
        const time = new Intl.DateTimeFormat("es-AR", {
          hour: "2-digit",
          minute: "2-digit",
          timeZone: "America/Argentina/Buenos_Aires",
        }).format(new Date());
        setField("webcamTime", `al aire ${time}`);
      };

      const reloadWebcam = (force = false): void => {
        if (!webcamImg || document.hidden || navigator.onLine === false) return;
        if (webcamLoading) webcamLoading.hidden = false;
        webcamImg.src = `/api/webcam?t=${Date.now()}${force ? "&refresh=1" : ""}`;
      };

      if (webcamImg) {
        webcamImg.addEventListener("load", () => {
          webcamImg.classList.add("loaded");
          if (webcamLoading) webcamLoading.hidden = true;
          if (webcamCard) webcamCard.hidden = false;
          webcamLoaded = true;
          webcamLabel();
          if (lightbox && !lightbox.hidden && lightboxImg) {
            lightboxImg.src = webcamImg.src;
          }
        });
        webcamImg.addEventListener("error", () => {
          if (webcamLoading) webcamLoading.hidden = true;
          if (webcamCard) webcamCard.hidden = !webcamLoaded;
        });
      }

      const startWebcam = (): void => {
        if (webcamTimer !== null) return;
        reloadWebcam();
        webcamTimer = window.setInterval(reloadWebcam, CAMERA_REFRESH_MS);
      };

      const openLightbox = (): void => {
        if (!lightbox || !lightboxImg || !webcamImg || !webcamLoaded) return;
        lightboxImg.src = webcamImg.src;
        lightbox.hidden = false;
      };

      const closeLightbox = (): void => {
        if (!lightbox) return;
        lightbox.hidden = true;
        if (lightboxImg) lightboxImg.removeAttribute("src");
      };

      webcamZoom?.addEventListener("click", openLightbox);
      webcamZoom?.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          openLightbox();
        }
      });
      lightboxClose?.addEventListener("click", closeLightbox);
      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && lightbox && !lightbox.hidden) closeLightbox();
      });

      webcamRefreshBtn?.addEventListener("click", () => reloadWebcam(true));
      lightboxRefresh?.addEventListener("click", () => reloadWebcam(true));

      document.querySelector<HTMLElement>("[data-refresh]")?.addEventListener("click", () => {
        load();
        reloadWebcam(true);
      });

      window.addEventListener("online", () => {
        load();
        reloadWebcam();
      });
      window.addEventListener("offline", () => {
        setStatus("error");
        showOffline(true);
        setField("updated", "Sin conexión a internet");
      });
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden && navigator.onLine) {
          load();
          reloadWebcam();
        }
      });

      const radarToggle = document.querySelector<HTMLButtonElement>("[data-radar-toggle]");
      const radarBody = document.querySelector<HTMLElement>("[data-radar-body]");
      const radarLayerSelect = document.querySelector<HTMLSelectElement>("[data-radar-layer]");
      const radarRefreshBtn = document.querySelector<HTMLElement>("[data-radar-refresh]");
      const radarTime = document.querySelector<HTMLElement>("[data-radar-time]");
      const radarIframe = document.querySelector<HTMLIFrameElement>("[data-radar-iframe]");
      const radarImg = document.querySelector<HTMLImageElement>("[data-radar-img]");
      const radarLoading = document.querySelector<HTMLElement>("[data-radar-loading]");
      const radarFullscreenBtn = document.querySelector<HTMLButtonElement>("[data-radar-fullscreen]");
      const radarFrame = document.querySelector<HTMLElement>("[data-radar-frame]");

      const RADAR_URLS: Record<string, string> = {
        rainviewer: "https://www.rainviewer.com/map.html?loc=-34.8906,-60.0058,8&oFa=0&oC=1&oU=0&oCl=0&c=1&o=83&layer=radar&sm=1&ts=1",
        goes19_geocolor: "https://cdn.star.nesdis.noaa.gov/GOES19/ABI/SECTOR/ssa/GEOCOLOR/latest.jpg",
        goes19_ir: "https://cdn.star.nesdis.noaa.gov/GOES19/ABI/SECTOR/ssa/13/latest.jpg",
        goes19_sandwich: "https://cdn.star.nesdis.noaa.gov/GOES19/ABI/SECTOR/ssa/Sandwich/latest.jpg",
      };

      let radarInitialized = false;

      const updateRadarTime = (): void => {
        if (!radarTime) return;
        const now = new Intl.DateTimeFormat("es-AR", {
          hour: "2-digit",
          minute: "2-digit",
          timeZone: "America/Argentina/Buenos_Aires",
        }).format(new Date());
        radarTime.textContent = `al aire ${now}`;
      };

      const loadRadarLayer = (force = false): void => {
        const layer = radarLayerSelect?.value || "rainviewer";
        const url = RADAR_URLS[layer] || RADAR_URLS.rainviewer;
        if (radarLoading) radarLoading.classList.add("active");

        if (layer === "rainviewer") {
          if (radarImg) {
            radarImg.hidden = true;
            radarImg.classList.remove("loaded");
          }
          if (radarIframe) {
            radarIframe.hidden = false;
            const targetUrl = force ? `${url}&_t=${Date.now()}` : url;
            if (radarIframe.src !== targetUrl) {
              radarIframe.src = targetUrl;
            } else {
              if (radarLoading) radarLoading.classList.remove("active");
            }
          }
        } else {
          if (radarIframe) radarIframe.hidden = true;
          if (radarImg) {
            radarImg.hidden = false;
            radarImg.classList.remove("loaded");
            radarImg.src = `${url}?t=${Date.now()}`;
          }
        }
        updateRadarTime();
      };

      if (radarIframe) {
        radarIframe.addEventListener("load", () => {
          if (radarLoading) radarLoading.classList.remove("active");
        });
      }
      if (radarImg) {
        radarImg.addEventListener("load", () => {
          radarImg.classList.add("loaded");
          if (radarLoading) radarLoading.classList.remove("active");
        });
        radarImg.addEventListener("error", () => {
          if (radarLoading) radarLoading.classList.remove("active");
        });
      }

      if (radarToggle && radarBody) {
        radarToggle.addEventListener("click", () => {
          const isExpanded = radarToggle.getAttribute("aria-expanded") === "true";
          const nextState = !isExpanded;
          radarToggle.setAttribute("aria-expanded", String(nextState));
          radarBody.hidden = !nextState;

          const pill = radarToggle.querySelector<HTMLElement>(".radar-badge-pill");
          if (pill) {
            pill.textContent = nextState ? "Ocultar" : "Ver mapa";
          }

          if (nextState && !radarInitialized) {
            radarInitialized = true;
            loadRadarLayer();
          }
        });
      }

      radarLayerSelect?.addEventListener("change", () => {
        loadRadarLayer();
      });

      radarRefreshBtn?.addEventListener("click", () => {
        loadRadarLayer(true);
      });

      radarFullscreenBtn?.addEventListener("click", () => {
        if (!radarFrame) return;
        if (!document.fullscreenElement) {
          radarFrame.requestFullscreen?.().catch(() => {});
        } else {
          document.exitFullscreen?.().catch(() => {});
        }
      });

      const isIPadOS =
        navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1;
      const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent) || isIPadOS;
      const uaMobile = /android|iphone|ipad|ipod|mobile|tablet|silk|kindle/i.test(
        navigator.userAgent,
      );
      const dataMobile = (
        navigator as unknown as { userAgentData?: { mobile?: boolean } }
      ).userAgentData?.mobile;
      const isMobileOrTablet =
        typeof dataMobile === "boolean"
          ? dataMobile || isIPadOS
          : uaMobile || isIPadOS;
      const displayStandalone = (): boolean =>
        window.matchMedia("(display-mode: standalone)").matches ||
        window.matchMedia("(display-mode: minimal-ui)").matches ||
        (navigator as unknown as { standalone?: boolean }).standalone === true;

      const installCard = document.querySelector<HTMLElement>("[data-install-card]");
      const installButton = document.querySelector<HTMLElement>("[data-install]");
      const installHint = document.querySelector<HTMLElement>("[data-install-hint]");
      const installFab = document.querySelector<HTMLElement>("[data-install-fab]");

      let canPrompt = false;
      let deferredPrompt: any = null;
      let installed = displayStandalone() || localStorage.getItem("clima-installed") === "1";

      const refreshInstallUI = (): void => {
        const base = isMobileOrTablet && !installed;
        if (installCard) installCard.hidden = !(base && (canPrompt || isIOS));
        if (installFab) installFab.hidden = !(base && canPrompt);
        if (isIOS) {
          if (installHint) installHint.textContent = 'Tocá Compartir y elegí "Agregar a pantalla de inicio".';
          if (installButton) installButton.hidden = true;
        }
        document.body.classList.toggle("has-fab", base && canPrompt);
      };

      const promptInstall = async (): Promise<void> => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        await deferredPrompt.userChoice;
        deferredPrompt = null;
        canPrompt = false;
        refreshInstallUI();
      };

      window.addEventListener("beforeinstallprompt", (event) => {
        event.preventDefault();
        deferredPrompt = event;
        canPrompt = true;
        refreshInstallUI();
      });
      window.addEventListener("appinstalled", () => {
        installed = true;
        localStorage.setItem("clima-installed", "1");
        refreshInstallUI();
      });
      installButton?.addEventListener("click", promptInstall);
      installFab?.addEventListener("click", promptInstall);
      refreshInstallUI();

      if ("serviceWorker" in navigator && import.meta.env.PROD) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }

      const ptr = document.querySelector<HTMLElement>("[data-ptr]");
      const PTR_THRESHOLD = 64;
      let pullStartY = 0;
      let pulling = false;
      let pullDistance = 0;

      const setPull = (distance: number): void => {
        if (!ptr) return;
        ptr.style.opacity = String(Math.min(distance / 56, 1));
        ptr.style.transform = `translateY(${distance - 56}px)`;
      };
      const resetPull = (): void => {
        if (!ptr) return;
        ptr.classList.remove("spinning");
        ptr.style.opacity = "0";
        ptr.style.transform = "translateY(-64px)";
      };
      const startPtrLoading = (): void => {
        if (!ptr) return;
        ptr.classList.add("spinning");
        ptr.style.opacity = "1";
        ptr.style.transform = "translateY(0)";
      };

      if (isMobileOrTablet) {
        window.addEventListener(
          "touchstart",
          (event) => {
            if (window.scrollY <= 0 && event.touches.length === 1) {
              pullStartY = event.touches[0].clientY;
              pulling = true;
              pullDistance = 0;
            }
          },
          { passive: true },
        );

        window.addEventListener(
          "touchmove",
          (event) => {
            if (!pulling) return;
            const delta = event.touches[0].clientY - pullStartY;
            if (delta <= 0 || window.scrollY > 0) {
              if (delta < -8) {
                pulling = false;
                resetPull();
              }
              return;
            }
            if (event.cancelable) event.preventDefault();
            pullDistance = Math.min(delta * 0.5, 88);
            setPull(pullDistance);
          },
          { passive: false },
        );

        window.addEventListener("touchend", () => {
          if (!pulling) return;
          pulling = false;
          if (pullDistance >= PTR_THRESHOLD) {
            startPtrLoading();
            reloadWebcam(true);
            load().finally(() => setTimeout(resetPull, 500));
          } else {
            resetPull();
          }
        });
      }

      load();
      setInterval(load, REFRESH_MS);
      startWebcam();
    </script>
  </body>
</html>
