---
const REFRESH_SECONDS = 60;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Clima en vivo de Chivilcoy, datos de la estación local." />
    <title>Clima Chivilcoy</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#111318" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Clima" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;500;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&amp;icon_names=air,arrow_downward,arrow_upward,close,dark_mode,download,fullscreen,humidity_high,light_mode,photo_camera,rainy,refresh,speed,water,water_drop,wb_twilight,wifi_off&amp;display=block"
      rel="stylesheet"
    />
    <style>
      :root {
        color-scheme: dark;
        --md-sys-color-primary: #a8c7fa;
        --md-sys-color-on-primary: #0a305f;
        --md-sys-color-primary-container: #284777;
        --md-sys-color-on-primary-container: #d6e3ff;
        --md-sys-color-secondary-container: #3f4759;
        --md-sys-color-on-secondary-container: #dbe2f9;
        --md-sys-color-surface: #111318;
        --md-sys-color-surface-container-lowest: #0c0e13;
        --md-sys-color-surface-container-low: #191c20;
        --md-sys-color-surface-container: #1d2024;
        --md-sys-color-surface-container-high: #282a2f;
        --md-sys-color-surface-container-highest: #33353a;
        --md-sys-color-on-surface: #e2e2e9;
        --md-sys-color-on-surface-variant: #c4c6d0;
        --md-sys-color-outline: #8e9099;
        --md-sys-color-outline-variant: #44474f;
        --md-sys-color-error: #ffb4ab;
        --md-sys-color-error-container: #93000a;
        --md-sys-color-on-error-container: #ffdad6;
        --md-sys-color-background: #111318;
        --md-sys-color-on-background: #e2e2e9;
        --radius: 16px;
      }
      * {
        box-sizing: border-box;
      }
      [hidden] {
        display: none !important;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        background: var(--md-sys-color-background);
        color: var(--md-sys-color-on-surface);
        font-family: Roboto, system-ui, -apple-system, "Segoe UI", sans-serif;
        display: flex;
        justify-content: center;
        padding: 16px 16px 40px;
        overscroll-behavior-y: contain;
        -webkit-tap-highlight-color: transparent;
      }
      body.has-fab {
        padding-bottom: 104px;
      }
      .app {
        width: 100%;
        max-width: 680px;
      }
      .app-bar {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 8px 4px 20px;
      }
      .logo {
        width: 44px;
        height: 44px;
        border-radius: 12px;
        flex-shrink: 0;
      }
      .app-bar-text {
        flex: 1;
        min-width: 0;
      }
      h1 {
        font-size: 1.35rem;
        font-weight: 500;
        margin: 0;
      }
      .support {
        color: var(--md-sys-color-on-surface-variant);
        margin: 2px 0 0;
        font-size: 0.8rem;
      }
      .status {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--md-sys-color-outline);
        flex-shrink: 0;
      }
      .status.live {
        background: #6dd58c;
        animation: pulse 2s infinite;
      }
      .status.error {
        background: var(--md-sys-color-error);
      }
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(109, 213, 140, 0.5); }
        70% { box-shadow: 0 0 0 8px rgba(109, 213, 140, 0); }
        100% { box-shadow: 0 0 0 0 rgba(109, 213, 140, 0); }
      }
      .card {
        background: var(--md-sys-color-surface-container);
        border-radius: var(--radius);
        padding: 18px;
        margin-bottom: 14px;
      }
      .card.elevated {
        background: var(--md-sys-color-surface-container-low);
        box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3), 0 1px 3px 1px rgba(0, 0, 0, 0.15);
      }
      .banner {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--md-sys-color-error-container);
        color: var(--md-sys-color-on-error-container);
        border-radius: var(--radius);
        padding: 12px 16px;
        font-size: 0.9rem;
        margin-bottom: 14px;
      }
      .banner md-icon {
        --md-icon-size: 20px;
      }
      .install-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
      }
      .install-card strong {
        font-size: 0.95rem;
        font-weight: 500;
      }
      .install-card p {
        margin: 4px 0 0;
        font-size: 0.82rem;
        color: var(--md-sys-color-on-surface-variant);
      }
      .install-card md-filled-button {
        flex-shrink: 0;
      }
      .hero {
        background: var(--md-sys-color-surface-container-high);
      }
      .hero-row {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 16px;
      }
      .temp {
        font-size: 4.5rem;
        font-weight: 400;
        line-height: 0.95;
        letter-spacing: -2px;
      }
      .temp .unit {
        font-size: 1.5rem;
        color: var(--md-sys-color-on-surface-variant);
        margin-left: 4px;
        letter-spacing: 0;
      }
      .feels {
        color: var(--md-sys-color-on-surface-variant);
        margin: 8px 0 0;
        font-size: 0.9rem;
      }
      .extremes {
        text-align: right;
        font-size: 0.85rem;
        color: var(--md-sys-color-on-surface-variant);
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .extremes span {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        justify-content: flex-end;
      }
      .extremes md-icon {
        --md-icon-size: 18px;
        color: var(--md-sys-color-primary);
      }
      .extremes b {
        color: var(--md-sys-color-on-surface);
      }
      .forecast-head {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 12px;
      }
      .forecast-icon {
        width: 48px;
        height: 48px;
      }
      .forecast-heading {
        display: flex;
        flex-direction: column;
      }
      .forecast-label {
        font-size: 0.72rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--md-sys-color-on-surface-variant);
      }
      .forecast-period {
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--md-sys-color-primary);
      }
      .forecast-condition {
        font-size: 1.35rem;
        font-weight: 500;
        margin-bottom: 12px;
      }
      .forecast-details {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .forecast-chip {
        background: var(--md-sys-color-surface-container-high);
        color: var(--md-sys-color-on-surface-variant);
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 0.85rem;
      }
      .forecast-note {
        margin: 14px 0 0;
        font-size: 0.72rem;
        line-height: 1.4;
        color: var(--md-sys-color-outline);
      }
      .webcam-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
      }
      .webcam-actions {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .webcam-time {
        font-size: 0.72rem;
        color: var(--md-sys-color-on-surface-variant);
      }
      .webcam-frame {
        position: relative;
        aspect-ratio: 16 / 9;
        border-radius: 12px;
        overflow: hidden;
        background: var(--md-sys-color-surface-container-highest);
        cursor: zoom-in;
      }
      .webcam-frame:focus-visible {
        outline: 2px solid var(--md-sys-color-primary);
        outline-offset: 2px;
      }
      .webcam-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      .webcam-img.loaded {
        opacity: 1;
      }
      .webcam-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--md-sys-color-outline);
        background: var(--md-sys-color-surface-container-high);
      }
      .webcam-overlay md-icon {
        font-size: 28px;
        animation: spin 1s linear infinite;
      }
      .webcam-zoom-hint {
        position: absolute;
        right: 8px;
        bottom: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.55);
        color: #fff;
        pointer-events: none;
      }
      .webcam-zoom-hint md-icon {
        font-size: 20px;
      }
      .webcam-note {
        margin: 10px 0 0;
        font-size: 0.72rem;
        line-height: 1.4;
        color: var(--md-sys-color-outline);
      }
      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        background: rgba(0, 0, 0, 0.94);
      }
      .lightbox-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: max(8px, env(safe-area-inset-top)) 8px 8px 16px;
        color: #fff;
        flex-shrink: 0;
      }
      .lightbox-title {
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0.02em;
      }
      .lightbox-actions {
        display: flex;
        gap: 4px;
        color: #fff;
      }
      .lightbox-actions md-icon-button {
        color: #fff;
      }
      .lightbox-img {
        flex: 1;
        min-height: 0;
        width: 100%;
        object-fit: contain;
        padding: 8px 8px max(8px, env(safe-area-inset-bottom));
      }
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
        margin-bottom: 14px;
      }
      .metric {
        margin-bottom: 0;
      }
      .metric-head {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--md-sys-color-on-surface-variant);
        font-size: 0.75rem;
        font-weight: 500;
        letter-spacing: 0.4px;
        text-transform: uppercase;
      }
      .metric-head md-icon {
        --md-icon-size: 18px;
        color: var(--md-sys-color-primary);
      }
      .metric-value {
        font-size: 1.6rem;
        font-weight: 400;
        margin-top: 8px;
      }
      .metric-value small {
        font-size: 0.85rem;
        color: var(--md-sys-color-on-surface-variant);
        margin-left: 4px;
      }
      .metric-sub {
        color: var(--md-sys-color-on-surface-variant);
        font-size: 0.75rem;
        margin-top: 4px;
      }
      .sun-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
        gap: 16px;
      }
      .sun-item .metric-head {
        text-transform: none;
        letter-spacing: 0;
      }
      .sun-value {
        font-size: 1.35rem;
        font-weight: 400;
        margin-top: 6px;
      }
      .sun-sub {
        color: var(--md-sys-color-on-surface-variant);
        font-size: 0.75rem;
        margin-top: 2px;
      }
      footer {
        margin-top: 20px;
        text-align: center;
        color: var(--md-sys-color-on-surface-variant);
        font-size: 0.75rem;
        line-height: 1.7;
      }
      footer a {
        color: var(--md-sys-color-primary);
        text-decoration: none;
      }
      .socials {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-bottom: 14px;
      }
      .social {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--md-sys-color-on-surface-variant);
        background: var(--md-sys-color-surface-container-high);
        transition: color 0.2s ease, background 0.2s ease, transform 0.2s ease;
      }
      .social:hover,
      .social:focus-visible {
        color: var(--md-sys-color-primary);
        background: var(--md-sys-color-surface-container-highest);
        transform: translateY(-2px);
      }
      .social svg {
        width: 20px;
        height: 20px;
        fill: currentColor;
      }
      .footer-text {
        margin: 0;
      }
      .install-fab {
        position: fixed;
        left: 16px;
        right: auto;
        bottom: calc(16px + env(safe-area-inset-bottom));
        z-index: 12;
      }
      .ptr {
        position: fixed;
        top: calc(10px + env(safe-area-inset-top));
        left: 50%;
        width: 42px;
        height: 42px;
        margin-left: -21px;
        border-radius: 50%;
        background: var(--md-sys-color-surface-container-highest);
        color: var(--md-sys-color-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        opacity: 0;
        transform: translateY(-64px);
        transition: opacity 0.15s ease;
        pointer-events: none;
        z-index: 20;
      }
      .ptr md-icon {
        --md-icon-size: 22px;
      }
      .ptr.spinning md-icon {
        animation: spin 0.8s linear infinite;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
      @media (max-width: 600px) {
        .grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .sun-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 460px) {
        .temp { font-size: 3.5rem; }
        .hero-row { flex-direction: column; align-items: flex-start; }
        .extremes { text-align: left; flex-direction: row; }
        .extremes span { justify-content: flex-start; }
        .install-card { flex-direction: column; align-items: flex-start; }
      }
    </style>
  </head>
  <body>
    <main class="app">
      <header class="app-bar">
        <img class="logo" src="/favicon.svg" alt="Clima Chivilcoy" width="44" height="44" />
        <div class="app-bar-text">
          <h1>Clima Chivilcoy</h1>
          <p class="support" data-field="updated">Cargando datos...</p>
        </div>
        <span class="status" data-status aria-hidden="true"></span>
        <md-icon-button data-refresh aria-label="Actualizar">
          <md-icon>refresh</md-icon>
        </md-icon-button>
      </header>

      <div class="banner" data-offline hidden role="status">
        <md-icon>wifi_off</md-icon>
        <span>Sin conexión a internet</span>
      </div>

      <div class="card install-card" data-install-card hidden>
        <div>
          <strong>Instalá la app</strong>
          <p data-install-hint>Accedé al clima con un toque, como una app de Android.</p>
        </div>
        <md-filled-button data-install>
          <md-icon slot="icon">download</md-icon>
          Instalar
        </md-filled-button>
      </div>

      <section class="card hero">
        <div class="hero-row">
          <div>
            <div class="temp"><span data-field="temperature">--</span><span class="unit">°C</span></div>
            <p class="feels">Sensación térmica <span data-field="feelsLike">--</span>°</p>
          </div>
          <div class="extremes">
            <span><md-icon>arrow_upward</md-icon> Máx <b data-field="temperatureMax">--</b>°</span>
            <span><md-icon>arrow_downward</md-icon> Mín <b data-field="temperatureMin">--</b>°</span>
          </div>
        </div>
      </section>

      <section class="card elevated forecast-card">
        <div class="forecast-head">
          <img class="forecast-icon" data-field="forecastIcon" alt="" hidden />
          <div class="forecast-heading">
            <span class="forecast-label">Pronóstico</span>
            <span class="forecast-period" data-field="forecastPeriod">--</span>
          </div>
        </div>
        <div class="forecast-condition" data-field="forecastCondition">Sin pronóstico</div>
        <div class="forecast-details" data-field="forecastDetails"></div>
        <p class="forecast-note">
          Estimación a partir de modelos meteorológicos (no es una medición en vivo de la
          estación).
        </p>
      </section>

      <section class="card webcam-card" data-webcam-card hidden>
        <div class="webcam-head">
          <div class="metric-head"><md-icon>photo_camera</md-icon> Cámara en vivo</div>
          <div class="webcam-actions">
            <span class="webcam-time" data-field="webcamTime">--</span>
            <md-icon-button data-webcam-refresh aria-label="Actualizar la cámara ahora">
              <md-icon>refresh</md-icon>
            </md-icon-button>
          </div>
        </div>
        <div class="webcam-frame" data-webcam-zoom role="button" tabindex="0" aria-label="Ver la cámara en pantalla completa">
          <img class="webcam-img" data-webcam-img alt="Vista en vivo desde la estación" />
          <div class="webcam-overlay" data-webcam-loading>
            <md-icon>refresh</md-icon>
          </div>
          <span class="webcam-zoom-hint" aria-hidden="true"><md-icon>fullscreen</md-icon></span>
        </div>
        <p class="webcam-note">
          Cámara de la estación con lecturas · se actualiza sola cada ~2 min. Tocá la imagen
          para agrandar o el botón para refrescar al instante.
        </p>
      </section>

      <section class="grid">
        <article class="card metric">
          <div class="metric-head"><md-icon>humidity_high</md-icon> Humedad</div>
          <div class="metric-value"><span data-field="humidity">--</span><small>%</small></div>
          <div class="metric-sub">Máx <span data-field="humidityMax">--</span>% · Mín <span data-field="humidityMin">--</span>%</div>
        </article>
        <article class="card metric">
          <div class="metric-head"><md-icon>water_drop</md-icon> Punto de rocío</div>
          <div class="metric-value"><span data-field="dewpoint">--</span><small>°C</small></div>
          <div class="metric-sub" data-field="dewpointTrend">--</div>
        </article>
        <article class="card metric">
          <div class="metric-head"><md-icon>speed</md-icon> Presión</div>
          <div class="metric-value"><span data-field="pressure">--</span><small>hPa</small></div>
          <div class="metric-sub" data-field="pressureTrend">--</div>
        </article>
        <article class="card metric">
          <div class="metric-head"><md-icon>air</md-icon> Viento</div>
          <div class="metric-value"><span data-field="windAvg">--</span><small>km/h</small></div>
          <div class="metric-sub">Ráfaga <span data-field="windMax">--</span> km/h · Recorrido <span data-field="windRun">--</span> km</div>
        </article>
        <article class="card metric">
          <div class="metric-head"><md-icon>rainy</md-icon> Lluvia hoy</div>
          <div class="metric-value"><span data-field="rainToday">--</span><small>mm</small></div>
          <div class="metric-sub">Mes <span data-field="rainMonth">--</span> mm</div>
        </article>
        <article class="card metric">
          <div class="metric-head"><md-icon>water</md-icon> Intensidad</div>
          <div class="metric-value"><span data-field="rainRate">--</span><small>mm/h</small></div>
          <div class="metric-sub">Lluvia por hora</div>
        </article>
      </section>

      <section class="card sun-grid">
        <div class="sun-item">
          <div class="metric-head"><md-icon>wb_twilight</md-icon> Amanecer</div>
          <div class="sun-value" data-field="sunrise">--</div>
        </div>
        <div class="sun-item">
          <div class="metric-head"><md-icon>wb_twilight</md-icon> Atardecer</div>
          <div class="sun-value" data-field="sunset">--</div>
        </div>
        <div class="sun-item">
          <div class="metric-head"><md-icon>light_mode</md-icon> Luz diurna</div>
          <div class="sun-value" data-field="daylight">--</div>
        </div>
        <div class="sun-item">
          <div class="metric-head"><md-icon>dark_mode</md-icon> Luna</div>
          <div class="sun-value" data-field="moonPhase">--</div>
          <div class="sun-sub"><span data-field="moonLuminance">--</span>% iluminada</div>
        </div>
      </section>

      <footer>
        <nav class="socials" aria-label="Redes y sitio de ClimaChivilcoy">
          <a class="social" href="https://climachivilcoy.com.ar/" target="_blank" rel="noopener noreferrer" title="Web" aria-label="Web de ClimaChivilcoy">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
          </a>
          <a class="social" href="https://t.me/climachivilcoy" target="_blank" rel="noopener noreferrer" title="Telegram" aria-label="Canal de Telegram de ClimaChivilcoy">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.26-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          </a>
          <a class="social" href="https://climachivilcoy.com.ar/whatsapp" target="_blank" rel="noopener noreferrer" title="WhatsApp" aria-label="WhatsApp de ClimaChivilcoy">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          </a>
          <a class="social" href="https://www.facebook.com/climachivilcoy/" target="_blank" rel="noopener noreferrer" title="Facebook" aria-label="Facebook de ClimaChivilcoy">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </nav>
        <p class="footer-text">
          Datos en vivo de <a href="https://climachivilcoy.com.ar/">ClimaChivilcoy</a> ·
          actualización automática cada {REFRESH_SECONDS} s
        </p>
      </footer>
    </main>

    <div class="ptr" data-ptr aria-hidden="true">
      <md-icon>refresh</md-icon>
    </div>

    <md-fab class="install-fab" data-install-fab variant="primary" label="Instalar" hidden>
      <md-icon slot="icon">download</md-icon>
    </md-fab>

    <div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Cámara en pantalla completa" hidden>
      <div class="lightbox-bar">
        <span class="lightbox-title">Cámara en vivo</span>
        <div class="lightbox-actions">
          <md-icon-button data-lightbox-refresh aria-label="Recargar imagen">
            <md-icon>refresh</md-icon>
          </md-icon-button>
          <md-icon-button data-lightbox-close aria-label="Cerrar pantalla completa">
            <md-icon>close</md-icon>
          </md-icon-button>
        </div>
      </div>
      <img class="lightbox-img" data-lightbox-img alt="Vista en vivo desde la estación" />
    </div>

    <script>
      import "@material/web/icon/icon.js";
      import "@material/web/iconbutton/icon-button.js";
      import "@material/web/button/filled-button.js";
      import "@material/web/fab/fab.js";

      const REFRESH_MS = 60_000;
      const CAMERA_REFRESH_MS = 120_000;

      const fmt = (value: number | null, digits = 1): string =>
        value === null || value === undefined ? "--" : value.toFixed(digits);

      const setField = (name: string, value: string): void => {
        document.querySelectorAll<HTMLElement>(`[data-field="${name}"]`).forEach((el) => {
          el.textContent = value;
        });
      };

      const setStatus = (state: "live" | "error" | "idle"): void => {
        const dot = document.querySelector<HTMLElement>("[data-status]");
        if (!dot) return;
        dot.classList.toggle("live", state === "live");
        dot.classList.toggle("error", state === "error");
      };

      const updatedLabel = (seconds: number | null): string => {
        if (seconds === null) return "Actualizado recientemente";
        if (seconds < 60) return `Actualizado hace ${seconds} s`;
        return `Actualizado hace ${Math.round(seconds / 60)} min`;
      };

      const forecastDateLabel = (offsetDays: number | null): string => {
        if (typeof offsetDays !== "number") return "";
        try {
          const date = new Date(Date.now() + offsetDays * 86_400_000);
          return new Intl.DateTimeFormat("es-AR", {
            weekday: "short",
            day: "numeric",
            month: "short",
            timeZone: "America/Argentina/Buenos_Aires",
          }).format(date);
        } catch {
          return "";
        }
      };

      const setForecastCard = (forecast: Record<string, any> | undefined): void => {
        const parts: string[] = [];
        if (forecast?.period) {
          const when = forecastDateLabel(forecast.periodOffsetDays);
          parts.push(when ? `${forecast.period} · ${when}` : forecast.period);
        }
        setField("forecastPeriod", parts.join(" ") || "Próximas horas");

        const fallback = forecast?.summary ?? "";
        let condition = forecast?.condition ?? fallback;
        if (forecast?.period && condition.toLowerCase().startsWith(forecast.period.toLowerCase())) {
          condition = condition.slice(forecast.period.length).trim();
        }
        setField("forecastCondition", condition || "Sin pronóstico");

        const wrap = document.querySelector<HTMLElement>('[data-field="forecastDetails"]');
        if (wrap) {
          wrap.textContent = "";
          const details = Array.isArray(forecast?.details) ? forecast.details : [];
          for (const detail of details) {
            const chip = document.createElement("span");
            chip.className = "forecast-chip";
            chip.textContent = detail;
            wrap.appendChild(chip);
          }
          wrap.hidden = details.length === 0;
        }
      };

      const render = (data: Record<string, any>): void => {
        setField("temperature", fmt(data.temperature));
        setField("feelsLike", fmt(data.feelsLike, 0));
        setField("temperatureMax", fmt(data.temperatureMax));
        setField("temperatureMin", fmt(data.temperatureMin));
        setField("humidity", data.humidity === null ? "--" : String(data.humidity));
        setField("humidityMax", data.humidityMax === null ? "--" : String(data.humidityMax));
        setField("humidityMin", data.humidityMin === null ? "--" : String(data.humidityMin));
        setField("dewpoint", fmt(data.dewpoint));
        setField("dewpointTrend", data.dewpointTrend ?? "--");
        setField("pressure", data.pressure === null ? "--" : String(data.pressure));
        setField("pressureTrend", data.pressureTrend ?? "--");
        setField("windAvg", fmt(data.windAvg));
        setField("windMax", fmt(data.windMax));
        setField("windRun", fmt(data.windRun, 0));
        setField("rainToday", fmt(data.rainToday));
        setField("rainMonth", fmt(data.rainMonth));
        setField("rainRate", fmt(data.rainRate));
        setField("sunrise", data.sunrise ?? "--");
        setField("sunset", data.sunset ?? "--");
        setField("daylight", data.daylight ? `${data.daylight} h` : "--");
        setField("moonPhase", data.moonPhase ?? "--");
        setField("moonLuminance", fmt(data.moonLuminance, 0));
        setForecastCard(data.forecast);

        const icon = document.querySelector<HTMLImageElement>('[data-field="forecastIcon"]');
        if (icon) {
          if (data.forecast?.icon) {
            icon.src = data.forecast.icon;
            icon.hidden = false;
          } else {
            icon.hidden = true;
          }
        }

        setField("updated", updatedLabel(data.sourceUpdatedSeconds));
      };

      const offlineBanner = document.querySelector<HTMLElement>("[data-offline]");
      const showOffline = (offline: boolean): void => {
        if (offlineBanner) offlineBanner.hidden = !offline;
      };

      const load = async (): Promise<void> => {
        try {
          const response = await fetch("/api/current", {
            headers: { Accept: "application/json" },
            cache: "no-store",
          });
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          render(await response.json());
          setStatus("live");
          showOffline(false);
        } catch {
          const offline = navigator.onLine === false;
          setStatus("error");
          showOffline(offline);
          setField(
            "updated",
            offline ? "Sin conexión a internet" : "No se pudo conectar con la estación",
          );
        }
      };

      const webcamCard = document.querySelector<HTMLElement>("[data-webcam-card]");
      const webcamImg = document.querySelector<HTMLImageElement>("[data-webcam-img]");
      const webcamLoading = document.querySelector<HTMLElement>("[data-webcam-loading]");
      const webcamZoom = document.querySelector<HTMLElement>("[data-webcam-zoom]");
      const webcamRefreshBtn = document.querySelector<HTMLElement>("[data-webcam-refresh]");
      const lightbox = document.querySelector<HTMLElement>("[data-lightbox]");
      const lightboxImg = document.querySelector<HTMLImageElement>("[data-lightbox-img]");
      const lightboxClose = document.querySelector<HTMLElement>("[data-lightbox-close]");
      const lightboxRefresh = document.querySelector<HTMLElement>("[data-lightbox-refresh]");
      let webcamLoaded = false;
      let webcamTimer: number | null = null;

      const webcamLabel = (): void => {
        const time = new Intl.DateTimeFormat("es-AR", {
          hour: "2-digit",
          minute: "2-digit",
          timeZone: "America/Argentina/Buenos_Aires",
        }).format(new Date());
        setField("webcamTime", `al aire ${time}`);
      };

      const reloadWebcam = (force = false): void => {
        if (!webcamImg || document.hidden || navigator.onLine === false) return;
        if (webcamLoading) webcamLoading.hidden = false;
        webcamImg.src = `/api/webcam?t=${Date.now()}${force ? "&refresh=1" : ""}`;
      };

      if (webcamImg) {
        webcamImg.addEventListener("load", () => {
          webcamImg.classList.add("loaded");
          if (webcamLoading) webcamLoading.hidden = true;
          if (webcamCard) webcamCard.hidden = false;
          webcamLoaded = true;
          webcamLabel();
          if (lightbox && !lightbox.hidden && lightboxImg) {
            lightboxImg.src = webcamImg.src;
          }
        });
        webcamImg.addEventListener("error", () => {
          if (webcamLoading) webcamLoading.hidden = true;
          if (webcamCard) webcamCard.hidden = !webcamLoaded;
        });
      }

      const startWebcam = (): void => {
        if (webcamTimer !== null) return;
        reloadWebcam();
        webcamTimer = window.setInterval(reloadWebcam, CAMERA_REFRESH_MS);
      };

      const openLightbox = (): void => {
        if (!lightbox || !lightboxImg || !webcamImg || !webcamLoaded) return;
        lightboxImg.src = webcamImg.src;
        lightbox.hidden = false;
      };

      const closeLightbox = (): void => {
        if (!lightbox) return;
        lightbox.hidden = true;
        if (lightboxImg) lightboxImg.removeAttribute("src");
      };

      webcamZoom?.addEventListener("click", openLightbox);
      webcamZoom?.addEventListener("keydown", (event) => {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          openLightbox();
        }
      });
      lightboxClose?.addEventListener("click", closeLightbox);
      lightbox?.addEventListener("click", (event) => {
        if (event.target === lightbox) closeLightbox();
      });
      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && lightbox && !lightbox.hidden) closeLightbox();
      });

      webcamRefreshBtn?.addEventListener("click", () => reloadWebcam(true));
      lightboxRefresh?.addEventListener("click", () => reloadWebcam(true));

      document.querySelector<HTMLElement>("[data-refresh]")?.addEventListener("click", () => {
        load();
        reloadWebcam(true);
      });

      window.addEventListener("online", () => {
        load();
        reloadWebcam();
      });
      window.addEventListener("offline", () => {
        setStatus("error");
        showOffline(true);
        setField("updated", "Sin conexión a internet");
      });
      document.addEventListener("visibilitychange", () => {
        if (!document.hidden && navigator.onLine) {
          load();
          reloadWebcam();
        }
      });

      const isIPadOS =
        navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1;
      const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent) || isIPadOS;
      const uaMobile = /android|iphone|ipad|ipod|mobile|tablet|silk|kindle/i.test(
        navigator.userAgent,
      );
      const dataMobile = (
        navigator as unknown as { userAgentData?: { mobile?: boolean } }
      ).userAgentData?.mobile;
      const isMobileOrTablet =
        typeof dataMobile === "boolean"
          ? dataMobile || isIPadOS
          : uaMobile || isIPadOS;
      const displayStandalone = (): boolean =>
        window.matchMedia("(display-mode: standalone)").matches ||
        window.matchMedia("(display-mode: minimal-ui)").matches ||
        (navigator as unknown as { standalone?: boolean }).standalone === true;

      const installCard = document.querySelector<HTMLElement>("[data-install-card]");
      const installButton = document.querySelector<HTMLElement>("[data-install]");
      const installHint = document.querySelector<HTMLElement>("[data-install-hint]");
      const installFab = document.querySelector<HTMLElement>("[data-install-fab]");

      let canPrompt = false;
      let deferredPrompt: any = null;
      let installed = displayStandalone() || localStorage.getItem("clima-installed") === "1";

      const refreshInstallUI = (): void => {
        const base = isMobileOrTablet && !installed;
        if (installCard) installCard.hidden = !(base && (canPrompt || isIOS));
        if (installFab) installFab.hidden = !(base && canPrompt);
        if (isIOS) {
          if (installHint) installHint.textContent = 'Tocá Compartir y elegí "Agregar a pantalla de inicio".';
          if (installButton) installButton.hidden = true;
        }
        document.body.classList.toggle("has-fab", base && canPrompt);
      };

      const promptInstall = async (): Promise<void> => {
        if (!deferredPrompt) return;
        deferredPrompt.prompt();
        await deferredPrompt.userChoice;
        deferredPrompt = null;
        canPrompt = false;
        refreshInstallUI();
      };

      window.addEventListener("beforeinstallprompt", (event) => {
        event.preventDefault();
        deferredPrompt = event;
        canPrompt = true;
        refreshInstallUI();
      });
      window.addEventListener("appinstalled", () => {
        installed = true;
        localStorage.setItem("clima-installed", "1");
        refreshInstallUI();
      });
      installButton?.addEventListener("click", promptInstall);
      installFab?.addEventListener("click", promptInstall);
      refreshInstallUI();

      if ("serviceWorker" in navigator && import.meta.env.PROD) {
        window.addEventListener("load", () => {
          navigator.serviceWorker.register("/sw.js").catch(() => {});
        });
      }

      const ptr = document.querySelector<HTMLElement>("[data-ptr]");
      const PTR_THRESHOLD = 64;
      let pullStartY = 0;
      let pulling = false;
      let pullDistance = 0;

      const setPull = (distance: number): void => {
        if (!ptr) return;
        ptr.style.opacity = String(Math.min(distance / 56, 1));
        ptr.style.transform = `translateY(${distance - 56}px)`;
      };
      const resetPull = (): void => {
        if (!ptr) return;
        ptr.classList.remove("spinning");
        ptr.style.opacity = "0";
        ptr.style.transform = "translateY(-64px)";
      };
      const startPtrLoading = (): void => {
        if (!ptr) return;
        ptr.classList.add("spinning");
        ptr.style.opacity = "1";
        ptr.style.transform = "translateY(0)";
      };

      if (isMobileOrTablet) {
        window.addEventListener(
          "touchstart",
          (event) => {
            if (window.scrollY <= 0 && event.touches.length === 1) {
              pullStartY = event.touches[0].clientY;
              pulling = true;
              pullDistance = 0;
            }
          },
          { passive: true },
        );

        window.addEventListener(
          "touchmove",
          (event) => {
            if (!pulling) return;
            const delta = event.touches[0].clientY - pullStartY;
            if (delta <= 0 || window.scrollY > 0) {
              if (delta < -8) {
                pulling = false;
                resetPull();
              }
              return;
            }
            if (event.cancelable) event.preventDefault();
            pullDistance = Math.min(delta * 0.5, 88);
            setPull(pullDistance);
          },
          { passive: false },
        );

        window.addEventListener("touchend", () => {
          if (!pulling) return;
          pulling = false;
          if (pullDistance >= PTR_THRESHOLD) {
            startPtrLoading();
            reloadWebcam(true);
            load().finally(() => setTimeout(resetPull, 500));
          } else {
            resetPull();
          }
        });
      }

      load();
      setInterval(load, REFRESH_MS);
      startWebcam();
    </script>
  </body>
</html>
