    <div class="lightbox" data-lightbox role="dialog" aria-modal="true" aria-label="Cámara en pantalla completa" hidden>
      <div class="lightbox-bar">
        <span class="lightbox-title">Cámara en vivo</span>
        <div class="lightbox-actions">
          <md-icon-button data-lightbox-refresh aria-label="Recargar imagen">
            <md-icon>refresh</md-icon>
          </md-icon-button>
          <md-icon-button data-lightbox-close aria-label="Cerrar pantalla completa">
            <md-icon>close</md-icon>
