---
const REFRESH_SECONDS = 60;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content="Clima en vivo de Chivilcoy, datos de la estación local." />
    <title>Clima Chivilcoy</title>
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#111318" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Clima" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Roboto:wght@300;400;500;700&amp;display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0..1,0&amp;display=block"
      rel="stylesheet"
    />
    <style is:global>
      :root {
        color-scheme: dark;
        --md-sys-color-primary: #a8c7fa;
        --md-sys-color-on-primary: #0a305f;
        --md-sys-color-primary-container: #284777;
        --md-sys-color-on-primary-container: #d6e3ff;
        --md-sys-color-secondary-container: #333d4d;
        --md-sys-color-on-secondary-container: #d6e3ff;
        --md-sys-color-surface: #111318;
        --md-sys-color-surface-container-lowest: #0c0e12;
        --md-sys-color-surface-container-low: #171a1f;
        --md-sys-color-surface-container: #1b1f26;
        --md-sys-color-surface-container-high: #262a32;
        --md-sys-color-surface-container-highest: #313640;
        --md-sys-color-on-surface: #e2e2e9;
        --md-sys-color-on-surface-variant: #c4c6d0;
        --md-sys-color-outline: #8e9099;
        --md-sys-color-outline-variant: rgba(255, 255, 255, 0.08);
        --md-sys-color-error: #ffb4ab;
        --md-sys-color-error-container: #93000a;
        --md-sys-color-on-error-container: #ffdad6;
        --md-sys-color-background: #111318;
        --md-sys-color-on-background: #e2e2e9;
        --radius: 28px;
        --radius-tile: 22px;
        --radius-sm: 14px;
        --radius-pill: 9999px;
      }
      * {
        box-sizing: border-box;
      }
      [hidden] {
        display: none !important;
      }
      body {
        margin: 0;
        min-height: 100dvh;
        background: var(--md-sys-color-background);
        color: var(--md-sys-color-on-surface);
        font-family: Roboto, system-ui, -apple-system, "Segoe UI", sans-serif;
        display: flex;
        justify-content: center;
        padding: 16px 16px 72px;
        overscroll-behavior-y: contain;
        -webkit-tap-highlight-color: transparent;
      }
      body.has-fab {
        padding-bottom: 120px;
      }
      .app {
        width: 100%;
        max-width: 680px;
      }
      .app-bar {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 8px 4px 20px;
      }
      .logo {
        width: 44px;
        height: 44px;
        border-radius: 14px;
        flex-shrink: 0;
      }
      .app-bar-text {
        flex: 1;
        min-width: 0;
      }
      h1 {
        font-size: 1.35rem;
        font-weight: 500;
        margin: 0;
        letter-spacing: -0.01em;
      }
      .support {
        color: var(--md-sys-color-on-surface-variant);
        margin: 2px 0 0;
        font-size: 0.8rem;
      }
      .status {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--md-sys-color-outline);
        flex-shrink: 0;
      }
      .status.live {
        background: #6dd58c;
        animation: pulse 2s infinite;
      }
      .status.error {
        background: var(--md-sys-color-error);
      }
      @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(109, 213, 140, 0.5); }
        70% { box-shadow: 0 0 0 8px rgba(109, 213, 140, 0); }
        100% { box-shadow: 0 0 0 0 rgba(109, 213, 140, 0); }
      }
      .card {
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid rgba(255, 255, 255, 0.05);
        border-radius: var(--radius);
        padding: 22px 20px;
        margin-bottom: 14px;
        box-shadow: none;
      }
      .card.elevated {
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid rgba(255, 255, 255, 0.05);
        box-shadow: none;
      }
      .banner {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--md-sys-color-error-container);
        color: var(--md-sys-color-on-error-container);
        border-radius: var(--radius-sm);
        padding: 12px 16px;
        font-size: 0.9rem;
        margin-bottom: 14px;
      }
      .banner md-icon {
        --md-icon-size: 20px;
        font-variation-settings: 'FILL' 1;
      }
      .install-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
      }
      .install-card strong {
        font-size: 0.95rem;
        font-weight: 500;
      }
      .install-card p {
        margin: 4px 0 0;
        font-size: 0.82rem;
        color: var(--md-sys-color-on-surface-variant);
      }
      .install-card md-filled-button {
        flex-shrink: 0;
      }
      .hero {
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid rgba(255, 255, 255, 0.06);
        padding: 24px 22px 22px;
      }
      .hero-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
      }
      .hero-main {
        display: flex;
        flex-direction: column;
      }
      .temp {
        font-size: 5rem;
        font-weight: 300;
        line-height: 0.95;
        letter-spacing: -3px;
        color: var(--md-sys-color-on-surface);
      }
      .temp .unit {
        font-size: 1.6rem;
        color: var(--md-sys-color-on-surface-variant);
        margin-left: 3px;
        letter-spacing: 0;
        font-weight: 400;
      }
      .feels {
        color: var(--md-sys-color-on-surface-variant);
        margin: 10px 0 0;
        font-size: 0.92rem;
        font-weight: 400;
      }
      .hero-side {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px;
        flex-shrink: 0;
      }
      .hero-icon-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        padding-right: 4px;
      }
      .hero-icon-wrap md-icon {
        --md-icon-size: 56px;
        font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }
      .hero-icon-wrap.wb_sunny md-icon,
      .hero-icon-wrap.sunny md-icon { color: #fdd663; }
      .hero-icon-wrap.partly_cloudy_day md-icon { color: #fbc02d; }
      .hero-icon-wrap.partly_cloudy_night md-icon { color: #90caf9; }
      .hero-icon-wrap.clear_night md-icon,
      .hero-icon-wrap.nights_stay md-icon { color: #aecbfa; }
      .hero-icon-wrap.cloud md-icon { color: #9aa0a6; }
      .hero-icon-wrap.rainy md-icon { color: #4fc3f7; }
      .hero-icon-wrap.thunderstorm md-icon { color: #5c6bc0; }
      .hero-icon-wrap.foggy md-icon { color: #cfd8dc; }
      .hero-icon-wrap.weather_snowy md-icon { color: #81d4fa; }
      .hero-icon-wrap.air md-icon { color: #80cbc4; }
      .extremes {
        text-align: right;
        font-size: 0.88rem;
        color: var(--md-sys-color-on-surface-variant);
        display: flex;
        flex-direction: column;
        gap: 6px;
      }
      .extremes span {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        justify-content: flex-end;
      }
      .extremes md-icon {
        --md-icon-size: 18px;
        color: var(--md-sys-color-primary);
        font-variation-settings: 'FILL' 1;
      }
      .extremes b {
        color: var(--md-sys-color-on-surface);
        font-weight: 600;
      }
      /* =========================================
         M3 Google Pixel Weather Styles
         ========================================= */
      .m3-weather-icon {
        font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24 !important;
        font-size: 26px;
        --md-icon-size: 26px;
        display: inline-block;
        flex-shrink: 0;
      }
      .m3-weather-icon.wb_sunny,
      .m3-weather-icon.sunny {
        color: #fdd663;
      }
      .m3-weather-icon.partly_cloudy_day {
        color: #fbc02d;
      }
      .m3-weather-icon.partly_cloudy_night,
      .m3-weather-icon.clear_night,
      .m3-weather-icon.nights_stay {
        color: #aecbfa;
      }
      .m3-weather-icon.cloud {
        color: #9aa0a6;
      }
      .m3-weather-icon.rainy {
        color: #4fc3f7;
      }
      .m3-weather-icon.thunderstorm {
        color: #5c6bc0;
      }
      .m3-weather-icon.foggy {
        color: #cfd8dc;
      }
      .m3-weather-icon.weather_snowy {
        color: #81d4fa;
      }
      .m3-weather-icon.air {
        color: #80cbc4;
      }

      /* Forecast Card - Local Station */
      .forecast-card {
        position: relative;
        overflow: hidden;
        border-radius: 28px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        background: var(--md-sys-color-surface-container-low);
        padding: 22px 20px 18px;
      }
      .forecast-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 16px;
        flex-wrap: wrap;
      }
      .forecast-title-col {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .forecast-title-row {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .forecast-badge {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        padding: 3px 9px;
        border-radius: 8px;
        background: rgba(109, 213, 140, 0.12);
        color: #6dd58c;
        border: 1px solid rgba(109, 213, 140, 0.25);
        letter-spacing: 0.04em;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .forecast-title {
        font-size: 1.15rem;
        font-weight: 500;
        color: var(--md-sys-color-on-surface);
        margin: 0;
        letter-spacing: -0.01em;
      }
      .forecast-subtitle {
        font-size: 0.78rem;
        color: var(--md-sys-color-on-surface-variant);
      }
      .forecast-period-badge {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--md-sys-color-primary);
        background: rgba(168, 199, 250, 0.1);
        padding: 5px 13px;
        border-radius: 999px;
        border: 1px solid rgba(168, 199, 250, 0.2);
        display: inline-flex;
        align-items: center;
        gap: 5px;
      }
      .forecast-head {
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 14px;
      }
      .forecast-icon-avatar {
        width: 62px;
        height: 62px;
        border-radius: 20px;
        background: var(--md-sys-color-surface-container-high);
        border: 1px solid rgba(255, 255, 255, 0.07);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .forecast-icon-avatar md-icon {
        --md-icon-size: 34px;
        font-variation-settings: 'FILL' 1, 'wght' 400, 'GRAD' 0, 'opsz' 24;
      }
      .forecast-icon-avatar.wb_sunny md-icon,
      .forecast-icon-avatar.sunny md-icon { color: #fdd663; }
      .forecast-icon-avatar.partly_cloudy_day md-icon { color: #fbc02d; }
      .forecast-icon-avatar.partly_cloudy_night md-icon { color: #90caf9; }
      .forecast-icon-avatar.clear_night md-icon,
      .forecast-icon-avatar.nights_stay md-icon { color: #aecbfa; }
      .forecast-icon-avatar.cloud md-icon { color: #9aa0a6; }
      .forecast-icon-avatar.rainy md-icon { color: #4fc3f7; }
      .forecast-icon-avatar.thunderstorm md-icon { color: #5c6bc0; }
      .forecast-icon-avatar.foggy md-icon { color: #cfd8dc; }
      .forecast-icon-avatar.weather_snowy md-icon { color: #81d4fa; }
      .forecast-icon-avatar.air md-icon { color: #80cbc4; }

      .forecast-heading {
        display: flex;
        flex-direction: column;
        gap: 4px;
        min-width: 0;
        flex: 1;
      }
      .forecast-condition {
        font-size: 1.25rem;
        font-weight: 500;
        line-height: 1.35;
        color: var(--md-sys-color-on-surface);
      }
      .forecast-details {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 14px;
      }
      .forecast-chip {
        background: var(--md-sys-color-surface-container-high);
        border: 1px solid rgba(255, 255, 255, 0.06);
        color: var(--md-sys-color-on-surface);
        padding: 7px 12px;
        border-radius: 12px;
        font-size: 0.82rem;
        font-weight: 500;
        display: inline-flex;
        align-items: center;
        gap: 7px;
      }
      .forecast-chip md-icon {
        --md-icon-size: 17px;
        color: var(--md-sys-color-primary);
        font-variation-settings: 'FILL' 1;
      }
      .forecast-note {
        margin: 16px 0 0;
        font-size: 0.74rem;
        line-height: 1.4;
        color: var(--md-sys-color-outline);
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .forecast-note md-icon {
        --md-icon-size: 16px;
        color: var(--md-sys-color-outline);
        flex-shrink: 0;
      }

      /* SMN Extended Forecast Card - M3 Pixel Style */
      .smn-forecast-card {
        border-radius: 28px;
        border: 1px solid rgba(255, 255, 255, 0.06);
        background: var(--md-sys-color-surface-container-low);
        padding: 22px 20px 18px;
      }
      .smn-forecast-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 14px;
        flex-wrap: wrap;
      }
      .smn-forecast-title-col {
        display: flex;
        flex-direction: column;
        gap: 4px;
      }
      .smn-forecast-title-row {
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .smn-forecast-badge {
        font-size: 0.68rem;
        font-weight: 600;
        text-transform: uppercase;
        padding: 3px 9px;
        border-radius: 8px;
        background: rgba(168, 199, 250, 0.12);
        color: #a8c7fa;
        border: 1px solid rgba(168, 199, 250, 0.25);
        letter-spacing: 0.04em;
        display: inline-flex;
        align-items: center;
        gap: 4px;
      }
      .smn-forecast-badge md-icon {
        --md-icon-size: 13px;
        font-variation-settings: 'FILL' 1;
      }
      .smn-forecast-title {
        font-size: 1.15rem;
        font-weight: 500;
        color: var(--md-sys-color-on-surface);
        margin: 0;
        letter-spacing: -0.01em;
      }
      .smn-forecast-subtitle {
        font-size: 0.78rem;
        color: var(--md-sys-color-on-surface-variant);
      }
      .smn-forecast-source {
        font-size: 0.75rem;
        font-weight: 500;
        color: var(--md-sys-color-on-surface-variant);
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: rgba(255, 255, 255, 0.04);
        padding: 5px 12px;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.07);
      }
      .smn-forecast-source md-icon {
        --md-icon-size: 15px;
        color: var(--md-sys-color-primary);
        font-variation-settings: 'FILL' 1;
      }

      /* Forecast List Container */
      .smn-forecast-list {
        display: flex;
        flex-direction: column;
        gap: 2px;
      }
      .m3-forecast-row {
        display: grid;
        grid-template-columns: 82px 48px 1fr auto;
        align-items: center;
        padding: 10px 8px;
        border-radius: 16px;
        transition: background-color 0.15s ease;
        gap: 8px;
      }
      .m3-forecast-row:hover {
        background: rgba(255, 255, 255, 0.035);
      }
      .m3-forecast-day-col {
        display: flex;
        flex-direction: column;
        gap: 1px;
      }
      .m3-forecast-day-name {
        font-size: 0.95rem;
        font-weight: 500;
        color: var(--md-sys-color-on-surface);
      }
      .m3-forecast-day-date {
        font-size: 0.74rem;
        color: var(--md-sys-color-outline);
      }
      .m3-forecast-icon-col {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 2px;
      }
      .m3-forecast-rain-prob {
        font-size: 0.68rem;
        font-weight: 600;
        color: #7fcfff;
        display: inline-flex;
        align-items: center;
        gap: 1px;
        line-height: 1;
      }
      .m3-forecast-rain-prob md-icon {
        --md-icon-size: 11px;
        font-variation-settings: 'FILL' 1;
      }
      .m3-forecast-info-col {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
        padding-right: 6px;
      }
      .m3-forecast-cond {
        font-size: 0.86rem;
        color: var(--md-sys-color-on-surface);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .m3-forecast-wind {
        font-size: 0.72rem;
        color: var(--md-sys-color-outline);
        display: inline-flex;
        align-items: center;
        gap: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .m3-forecast-wind md-icon {
        --md-icon-size: 12px;
        color: var(--md-sys-color-outline);
      }
      .m3-forecast-bar-col {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 12px;
      }
      .m3-temp-val {
        font-size: 0.92rem;
        min-width: 25px;
      }
      .m3-temp-val.min {
        text-align: right;
        color: var(--md-sys-color-on-surface-variant);
        font-weight: 400;
      }
      .m3-temp-val.max {
        text-align: left;
        color: var(--md-sys-color-on-surface);
        font-weight: 500;
      }

      @media (max-width: 480px) {
        .m3-forecast-row {
          grid-template-columns: 68px 44px 1fr auto;
          padding: 8px 4px;
          gap: 6px;
        }
        .m3-forecast-cond {
          font-size: 0.8rem;
        }
      }
      @media (max-width: 380px) {
        .m3-forecast-wind {
          display: none;
        }
        .m3-forecast-row {
          grid-template-columns: 58px 38px 1fr auto;
        }
      }
      .smn-forecast-note {
        margin: 16px 0 0;
        font-size: 0.74rem;
        line-height: 1.4;
        color: var(--md-sys-color-outline);
        display: flex;
        align-items: center;
        gap: 8px;
      }
      .smn-forecast-note md-icon {
        --md-icon-size: 16px;
        color: var(--md-sys-color-outline);
        flex-shrink: 0;
      }
      .smn-alerts-card {
        margin-bottom: 14px;
        border-left: 5px solid var(--smn-border-color, #fbc02d);
        background: var(--md-sys-color-surface-container-low);
        border-radius: var(--radius);
        border-top: 1px solid rgba(255, 255, 255, 0.05);
        border-right: 1px solid rgba(255, 255, 255, 0.05);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        padding: 20px 18px;
        transition: transform 0.2s ease, border-color 0.2s ease;
      }
      .smn-alerts-card.level-amarillo {
        --smn-border-color: #fbc02d;
      }
      .smn-alerts-card.level-naranja {
        --smn-border-color: #f57c00;
      }
      .smn-alerts-card.level-rojo {
        --smn-border-color: #d32f2f;
      }
      .smn-alert-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 10px;
      }
      .smn-alert-title-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
      }
      .smn-alert-badge {
        font-size: 0.7rem;
        font-weight: 700;
        text-transform: uppercase;
        padding: 3px 9px;
        border-radius: 8px;
        background: var(--smn-badge-bg, #fbc02d);
        color: var(--smn-badge-color, #000);
        letter-spacing: 0.04em;
      }
      .smn-alert-title {
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--md-sys-color-on-surface);
      }
      .smn-alert-source {
        font-size: 0.72rem;
        font-weight: 500;
        color: var(--md-sys-color-outline);
        white-space: nowrap;
      }
      .smn-alert-desc {
        font-size: 0.88rem;
        line-height: 1.45;
        color: var(--md-sys-color-on-surface-variant);
        margin: 0 0 10px;
      }
      .smn-alert-instructions {
        margin: 10px 0;
        padding: 12px 16px;
        background: var(--md-sys-color-surface-container-high);
        border-radius: var(--radius-sm);
        font-size: 0.82rem;
        line-height: 1.45;
        color: var(--md-sys-color-on-surface);
        white-space: pre-line;
      }
      .smn-alert-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        font-size: 0.75rem;
        color: var(--md-sys-color-outline);
      }
      .smn-alert-toggle-btn {
        background: transparent;
        border: none;
        color: var(--md-sys-color-primary);
        font-size: 0.8rem;
        font-weight: 500;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 5px 10px;
        border-radius: 8px;
      }
      .smn-alert-toggle-btn:hover {
        background: var(--md-sys-color-surface-container-high);
      }
      .smn-alert-toggle-btn md-icon {
        --md-icon-size: 16px;
        transition: transform 0.2s ease;
      }
      .smn-alert-toggle-btn.open md-icon {
        transform: rotate(180deg);
      }

      /* Webcam Card */
      .webcam-card {
        border-radius: var(--radius);
        border: 1px solid rgba(255, 255, 255, 0.05);
        background: var(--md-sys-color-surface-container-low);
        padding: 22px 20px 18px;
      }
      .webcam-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 12px;
      }
      .webcam-actions {
        display: flex;
        align-items: center;
        gap: 4px;
      }
      .webcam-time {
        font-size: 0.74rem;
        color: var(--md-sys-color-on-surface-variant);
      }
      .webcam-frame {
        position: relative;
        aspect-ratio: 16 / 9;
        border-radius: 20px;
        overflow: hidden;
        background: var(--md-sys-color-surface-container-high);
        cursor: zoom-in;
      }
      .webcam-frame:focus-visible {
        outline: 2px solid var(--md-sys-color-primary);
        outline-offset: 2px;
      }
      .webcam-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.4s ease;
      }
      .webcam-img.loaded {
        opacity: 1;
      }
      .webcam-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--md-sys-color-outline);
        background: var(--md-sys-color-surface-container-high);
      }
      .webcam-overlay md-icon {
        font-size: 28px;
        animation: spin 1s linear infinite;
      }
      .webcam-zoom-hint {
        position: absolute;
        right: 10px;
        bottom: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(0, 0, 0, 0.6);
        color: #fff;
        pointer-events: none;
      }
      .webcam-zoom-hint md-icon {
        font-size: 20px;
      }
      .webcam-note {
        margin: 12px 0 0;
        font-size: 0.74rem;
        line-height: 1.45;
        color: var(--md-sys-color-outline);
      }

      /* Radar Card */
      .radar-card {
        padding: 0;
        overflow: hidden;
        margin-bottom: 14px;
        border-radius: var(--radius);
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid rgba(255, 255, 255, 0.05);
        transition: border-color 0.2s ease;
      }
      .radar-card:hover {
        border-color: rgba(168, 199, 250, 0.25);
      }
      .radar-card-header {
        width: 100%;
        background: transparent;
        border: none;
        padding: 18px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        cursor: pointer;
        color: inherit;
        text-align: left;
        gap: 14px;
        transition: background-color 0.2s ease;
      }
      .radar-card-header:hover {
        background: var(--md-sys-color-surface-container);
      }
      .radar-head-left {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
      }
      .radar-icon-avatar {
        width: 48px;
        height: 48px;
        border-radius: 16px;
        background: var(--md-sys-color-surface-container-high);
        color: var(--md-sys-color-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .radar-icon-avatar md-icon {
        --md-icon-size: 26px;
        font-variation-settings: 'FILL' 1;
      }
      .radar-head-titles {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .radar-head-title {
        font-size: 1.05rem;
        font-weight: 500;
        color: var(--md-sys-color-on-surface);
        line-height: 1.25;
      }
      .radar-head-sub {
        font-size: 0.78rem;
        color: var(--md-sys-color-on-surface-variant);
        margin-top: 3px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .radar-head-right {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
      }
      .radar-badge-pill {
        font-size: 0.74rem;
        font-weight: 500;
        background: var(--md-sys-color-secondary-container);
        color: var(--md-sys-color-on-secondary-container);
        padding: 5px 12px;
        border-radius: 9999px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        transition: all 0.2s ease;
      }
      .radar-chevron-box {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: var(--md-sys-color-surface-container-high);
        color: var(--md-sys-color-on-surface);
        display: flex;
        align-items: center;
        justify-content: center;
        transition: transform 0.25s ease, background 0.2s ease;
      }
      .radar-chevron-box md-icon {
        --md-icon-size: 20px;
      }
      .radar-card-header[aria-expanded="true"] .radar-chevron-box {
        transform: rotate(180deg);
        background: var(--md-sys-color-primary-container);
        color: var(--md-sys-color-on-primary-container);
      }
      .radar-card-body {
        padding: 0 18px 18px;
        border-top: 1px solid rgba(255, 255, 255, 0.05);
      }
      .radar-controls {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 14px 0;
        flex-wrap: wrap;
      }
      .radar-select-wrap {
        display: flex;
        align-items: center;
        gap: 8px;
        flex: 1;
        min-width: 240px;
      }
      .radar-select-label {
        font-size: 0.78rem;
        color: var(--md-sys-color-on-surface-variant);
        white-space: nowrap;
      }
      .radar-select {
        flex: 1;
        padding: 8px 12px;
        border-radius: 12px;
        background: var(--md-sys-color-surface-container-high);
        color: var(--md-sys-color-on-surface);
        border: 1px solid rgba(255, 255, 255, 0.08);
        font-size: 0.82rem;
        font-family: inherit;
        outline: none;
        cursor: pointer;
      }
      .radar-select:focus {
        border-color: var(--md-sys-color-primary);
      }
      .radar-actions {
        display: flex;
        align-items: center;
        gap: 6px;
      }
      .radar-layer-time {
        font-size: 0.74rem;
        color: var(--md-sys-color-outline);
      }
      .radar-frame {
        position: relative;
        aspect-ratio: 16 / 10;
        border-radius: 20px;
        overflow: hidden;
        background: #0b0f14;
      }
      .radar-iframe {
        width: 100%;
        height: 100%;
        border: none;
        display: block;
      }
      .radar-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        opacity: 0;
        transition: opacity 0.3s ease;
      }
      .radar-img.loaded {
        opacity: 1;
      }
      .radar-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.45);
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.2s ease;
      }
      .radar-overlay.active {
        opacity: 1;
        pointer-events: auto;
      }
      .radar-overlay md-icon {
        --md-icon-size: 32px;
        color: #fff;
        animation: spin 1s linear infinite;
      }
      .radar-fullscreen-btn {
        position: absolute;
        bottom: 10px;
        right: 10px;
        background: rgba(0, 0, 0, 0.65);
        border: none;
        color: #fff;
        border-radius: 10px;
        padding: 7px;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        backdrop-filter: blur(6px);
      }
      .radar-fullscreen-btn:hover {
        background: rgba(0, 0, 0, 0.85);
      }
      .radar-fullscreen-btn md-icon {
        --md-icon-size: 18px;
      }
      .radar-frame:fullscreen {
        aspect-ratio: auto;
        width: 100vw;
        height: 100vh;
        border-radius: 0;
      }
      .radar-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-top: 12px;
        flex-wrap: wrap;
      }
      .radar-source-note {
        font-size: 0.72rem;
        color: var(--md-sys-color-outline);
        line-height: 1.4;
        flex: 1;
        min-width: 200px;
      }
      .radar-link-btn {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.75rem;
        color: var(--md-sys-color-primary);
        text-decoration: none;
        white-space: nowrap;
      }
      .radar-link-btn md-icon {
        --md-icon-size: 14px;
      }

      /* Lightbox */
      .lightbox {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        flex-direction: column;
        background: rgba(0, 0, 0, 0.94);
      }
      .lightbox-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: max(8px, env(safe-area-inset-top)) 8px 8px 16px;
        color: #fff;
        flex-shrink: 0;
      }
      .lightbox-title {
        font-size: 0.95rem;
        font-weight: 500;
        letter-spacing: 0.02em;
      }
      .lightbox-actions {
        display: flex;
        gap: 4px;
        color: #fff;
      }
      .lightbox-actions md-icon-button {
        color: #fff;
      }
      .lightbox-img {
        flex: 1;
        min-height: 0;
        width: 100%;
        object-fit: contain;
        padding: 8px 8px max(8px, env(safe-area-inset-bottom));
      }

      /* Bento Metric Tiles - Pixel Style */
      .grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
        gap: 12px;
        margin-bottom: 14px;
      }
      .metric {
        margin-bottom: 0;
        border-radius: var(--radius-tile);
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 18px 16px;
        transition: background-color 0.2s ease, border-color 0.2s ease;
      }
      .metric:hover {
        background: var(--md-sys-color-surface-container);
      }
      .metric-head {
        display: flex;
        align-items: center;
        gap: 6px;
        color: var(--md-sys-color-on-surface-variant);
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0;
        text-transform: none;
      }
      .metric-head md-icon {
        --md-icon-size: 19px;
        color: var(--md-sys-color-primary);
        font-variation-settings: 'FILL' 1;
      }
      .metric-value {
        font-size: 1.85rem;
        font-weight: 400;
        margin-top: 8px;
        color: var(--md-sys-color-on-surface);
        letter-spacing: -0.02em;
      }
      .metric-value small {
        font-size: 0.85rem;
        color: var(--md-sys-color-on-surface-variant);
        margin-left: 3px;
        font-weight: 400;
      }
      .metric-sub {
        color: var(--md-sys-color-outline);
        font-size: 0.76rem;
        margin-top: 4px;
        line-height: 1.35;
      }
      .station-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin: 10px 0 0;
        padding: 4px 12px;
        border-radius: 9999px;
        background: var(--md-sys-color-secondary-container);
        color: var(--md-sys-color-on-secondary-container);
        font-size: 0.74rem;
        font-weight: 500;
        width: fit-content;
      }
      .station-badge md-icon {
        font-size: 16px;
        font-variation-settings: 'FILL' 1;
      }

      /* Stations Section - M3 Style */
      .stations-section {
        margin-bottom: 20px;
      }
      .stations-header {
        margin-bottom: 12px;
      }
      .stations-header-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-wrap: wrap;
      }
      .stations-badge-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 10px;
        border-radius: 9999px;
        background: rgba(109, 213, 140, 0.12);
        border: 1px solid rgba(109, 213, 140, 0.25);
        color: #7ee79d;
        font-size: 0.72rem;
        font-weight: 500;
      }
      .stations-badge-pill .pulse-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #6dd58c;
        animation: pulse 2s infinite;
      }
      .stations-desc {
        margin: 6px 0 0;
        font-size: 0.78rem;
        color: var(--md-sys-color-outline);
        line-height: 1.45;
      }
      .station-selector {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
        gap: 10px;
        margin-bottom: 12px;
      }
      .station-tab {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 11px 14px;
        border-radius: 18px;
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid rgba(255, 255, 255, 0.05);
        color: var(--md-sys-color-on-surface-variant);
        cursor: pointer;
        font-family: inherit;
        transition: all 0.2s ease;
        text-align: left;
        outline: none;
      }
      .station-tab:hover {
        background: var(--md-sys-color-surface-container);
        color: var(--md-sys-color-on-surface);
      }
      .station-tab.active {
        background: var(--md-sys-color-secondary-container);
        border: 1px solid rgba(168, 199, 250, 0.35);
        color: var(--md-sys-color-on-secondary-container);
      }
      .station-tab-icon {
        width: 28px;
        height: 28px;
        border-radius: 8px;
        background: rgba(168, 199, 250, 0.12);
        color: var(--md-sys-color-primary);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .station-tab-icon md-icon {
        font-size: 18px;
        --md-icon-size: 18px;
        font-variation-settings: 'FILL' 1;
      }
      .station-tab img {
        width: 24px;
        height: 24px;
        object-fit: contain;
        border-radius: 4px;
        flex-shrink: 0;
      }
      .station-tab-info {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
      }
      .station-tab-name {
        font-size: 0.85rem;
        font-weight: 500;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .station-tab-tag {
        font-size: 0.7rem;
        opacity: 0.8;
      }
      .station-tab.active .station-tab-tag {
        opacity: 0.95;
      }
      .station-tab-temp {
        font-size: 0.95rem;
        font-weight: 600;
        margin-left: auto;
        flex-shrink: 0;
      }
      .station-status-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        padding: 4px 4px 10px;
      }
      .station-selected-meta {
        display: flex;
        align-items: baseline;
        gap: 8px;
        min-width: 0;
        flex-wrap: wrap;
      }
      .station-selected-title {
        font-size: 0.92rem;
        font-weight: 500;
        color: var(--md-sys-color-on-surface);
      }
      .station-selected-sub {
        font-size: 0.76rem;
        color: var(--md-sys-color-outline);
      }
      .station-selected-age {
        font-size: 0.72rem;
        color: var(--md-sys-color-on-surface-variant);
        background: var(--md-sys-color-surface-container-high);
        padding: 2px 9px;
        border-radius: 9999px;
        white-space: nowrap;
        flex-shrink: 0;
      }
      .station-metrics-grid {
        margin-bottom: 12px;
      }
      .station-actions-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 10px;
        margin-bottom: 0;
      }
      .station-action-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 16px;
        margin-bottom: 0;
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid rgba(255, 255, 255, 0.05);
        text-decoration: none;
        color: inherit;
        border-radius: 18px;
        transition: all 0.2s ease;
      }
      .station-action-card:hover,
      .station-action-card:focus-visible {
        border-color: rgba(168, 199, 250, 0.3);
        background: var(--md-sys-color-surface-container);
        transform: translateY(-1px);
      }
      .station-action-left {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
      }
      .station-action-avatar {
        width: 38px;
        height: 38px;
        border-radius: 12px;
        background: var(--md-sys-color-surface-container-high);
        border: 1px solid rgba(255, 255, 255, 0.06);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: var(--md-sys-color-primary);
      }
      .station-action-avatar md-icon {
        font-size: 20px;
        --md-icon-size: 20px;
        font-variation-settings: 'FILL' 1;
      }
      .station-action-avatar.map-avatar {
        color: #ff897d;
        background: rgba(255, 137, 125, 0.12);
        border-color: rgba(255, 137, 125, 0.25);
      }
      .station-action-avatar img {
        width: 22px;
        height: 22px;
        object-fit: contain;
        border-radius: 3px;
      }
      .station-action-text {
        display: flex;
        flex-direction: column;
        min-width: 0;
      }
      .station-action-title {
        font-size: 0.84rem;
        font-weight: 500;
        color: var(--md-sys-color-on-surface);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .station-action-url {
        font-size: 0.72rem;
        color: var(--md-sys-color-outline);
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }
      .station-action-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        padding: 6px 14px;
        border-radius: 9999px;
        background: var(--md-sys-color-primary);
        color: var(--md-sys-color-on-primary);
        font-size: 0.76rem;
        font-weight: 500;
        flex-shrink: 0;
        transition: transform 0.2s ease, opacity 0.2s ease;
      }
      .station-action-pill md-icon {
        font-size: 14px;
        --md-icon-size: 14px;
      }
      .station-action-pill.map-pill {
        background: var(--md-sys-color-surface-container-high);
        color: var(--md-sys-color-on-surface);
        border: 1px solid rgba(255, 255, 255, 0.08);
      }
      .station-action-card:hover .station-action-pill {
        opacity: 0.92;
      }
      @media (max-width: 520px) {
        .station-selector {
          grid-template-columns: 1fr;
        }
        .station-actions-grid {
          grid-template-columns: 1fr;
        }
      }

      /* Sun & Moon Card */
      .sun-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
        gap: 16px;
        border-radius: var(--radius);
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid rgba(255, 255, 255, 0.05);
        padding: 22px 20px;
      }
      .sun-item {
        display: flex;
        flex-direction: column;
      }
      .sun-item .metric-head {
        text-transform: none;
        letter-spacing: 0;
        font-size: 0.8rem;
      }
      .sun-item .metric-head md-icon {
        color: #fdd663;
        font-variation-settings: 'FILL' 1;
      }
      .sun-item:last-child .metric-head md-icon {
        color: #cfd8dc;
      }
      .sun-value {
        font-size: 1.45rem;
        font-weight: 400;
        margin-top: 8px;
        color: var(--md-sys-color-on-surface);
      }
      .sun-sub {
        color: var(--md-sys-color-on-surface-variant);
        font-size: 0.75rem;
        margin-top: 3px;
      }

      /* Footer */
      footer {
        margin-top: 32px;
        padding-top: 24px;
        border-top: 1px solid rgba(255, 255, 255, 0.06);
        text-align: center;
        color: var(--md-sys-color-on-surface-variant);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 18px;
      }
      .socials {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        margin: 0;
      }
      .social {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--md-sys-color-on-surface-variant);
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid rgba(255, 255, 255, 0.06);
        transition: all 0.2s ease;
        text-decoration: none;
      }
      .social:hover,
      .social:focus-visible {
        color: var(--md-sys-color-primary);
        background: var(--md-sys-color-surface-container-high);
        border-color: rgba(168, 199, 250, 0.4);
        transform: translateY(-2px);
      }
      .social svg {
        width: 20px;
        height: 20px;
        fill: currentColor;
      }
      .social-img {
        width: 22px;
        height: 22px;
        object-fit: contain;
        border-radius: 4px;
      }
      .footer-sources {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        font-size: 0.78rem;
      }
      .footer-sources-label {
        color: var(--md-sys-color-outline);
        font-size: 0.72rem;
        letter-spacing: 0.3px;
        text-transform: uppercase;
        font-weight: 500;
      }
      .footer-chips {
        display: flex;
        justify-content: center;
        gap: 8px;
        flex-wrap: wrap;
      }
      .footer-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 9999px;
        background: var(--md-sys-color-surface-container-low);
        border: 1px solid rgba(255, 255, 255, 0.05);
        color: var(--md-sys-color-on-surface);
        text-decoration: none;
        font-size: 0.76rem;
        font-weight: 500;
        transition: all 0.2s ease;
      }
      .footer-chip:hover,
      .footer-chip:focus-visible {
        border-color: var(--md-sys-color-primary);
        background: var(--md-sys-color-surface-container-high);
        transform: translateY(-1px);
        color: var(--md-sys-color-primary);
      }
      .footer-chip img {
        width: 14px;
        height: 14px;
        object-fit: contain;
        border-radius: 2px;
      }
      .footer-chip md-icon {
        font-size: 14px;
        --md-icon-size: 14px;
        color: var(--md-sys-color-outline);
      }
      .footer-chip:hover md-icon {
        color: var(--md-sys-color-primary);
      }
      .footer-note {
        margin: 0;
        font-size: 0.74rem;
        line-height: 1.5;
        color: var(--md-sys-color-outline);
        max-width: 480px;
        text-wrap: balance;
      }
      .creator-badge {
        position: fixed;
        left: 18px;
        bottom: calc(18px + env(safe-area-inset-bottom));
        z-index: 11;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        white-space: nowrap;
        padding: 9px 14px 9px 11px;
        border-radius: 999px;
        background: linear-gradient(180deg, #1d2024 0%, #131518 100%);
        backdrop-filter: blur(12px);
        -webkit-backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 255, 255, 0.12);
        text-decoration: none;
        color: #f4f9f9;
        font-size: 13px;
        font-weight: 600;
        letter-spacing: 0.01em;
        line-height: 1.2;
        box-shadow: 0 4px 16px rgba(0, 0, 0, 0.4);
        transition: border-color 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease, bottom 0.2s ease;
        max-width: calc(100vw - 36px);
      }
      .creator-badge:hover,
      .creator-badge:focus-visible {
        border-color: rgba(168, 199, 250, 0.35);
        transform: translateY(-1px);
        box-shadow: 0 6px 20px rgba(0, 0, 0, 0.55);
      }
      body.has-fab .creator-badge {
        bottom: calc(76px + env(safe-area-inset-bottom));
      }
      .creator-badge-icon {
        font-size: 18px;
        --md-icon-size: 18px;
        width: 18px;
        height: 18px;
        color: var(--md-sys-color-primary);
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .creator-badge-text {
        display: inline-flex;
        align-items: baseline;
        gap: 5px;
      }
      .creator-badge-label {
        color: #c4c6d0;
        font-weight: 500;
        font-size: 13px;
      }
      .creator-badge-name {
        color: #ffffff;
        font-weight: 700;
        font-size: 13px;
        transition: color 0.2s ease;
      }
      .creator-badge:hover .creator-badge-name {
        color: var(--md-sys-color-primary);
      }
      .install-fab {
        position: fixed;
        right: 16px;
        left: auto;
        bottom: calc(16px + env(safe-area-inset-bottom));
        z-index: 12;
      }
      .ptr {
        position: fixed;
        top: calc(10px + env(safe-area-inset-top));
        left: 50%;
        width: 42px;
        height: 42px;
        margin-left: -21px;
        border-radius: 50%;
        background: var(--md-sys-color-surface-container-highest);
        color: var(--md-sys-color-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
        opacity: 0;
        transform: translateY(-64px);
        transition: opacity 0.15s ease;
        pointer-events: none;
        z-index: 20;
      }
      .ptr md-icon {
        --md-icon-size: 22px;
      }
      .ptr.spinning md-icon {
        animation: spin 0.8s linear infinite;
      }
      @keyframes spin {
        to { transform: rotate(360deg); }
      }
      @media (max-width: 600px) {
        .grid {
          grid-template-columns: repeat(2, 1fr);
        }
        .sun-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }
      @media (max-width: 460px) {
        .temp { font-size: 3.8rem; }
        .hero-icon-wrap md-icon { --md-icon-size: 46px; }
        .hero-side { gap: 6px; }
        .install-card { flex-direction: column; align-items: flex-start; }
      }
    </style>
  </head>
  <body>
    <main class="app">
      <header class="app-bar">
        <img class="logo" src="/favicon.svg" alt="Clima Chivilcoy" width="44" height="44" />
        <div class="app-bar-text">
          <h1>Clima Chivilcoy</h1>
          <p class="support" data-field="updated">Cargando datos...</p>
        </div>
        <span class="status" data-status aria-hidden="true"></span>
        <md-icon-button data-refresh aria-label="Actualizar">
          <md-icon>refresh</md-icon>
        </md-icon-button>
      </header>

      <div class="banner" data-offline hidden role="status">
        <md-icon>wifi_off</md-icon>
        <span>Sin conexión a internet</span>
      </div>

      <div class="card install-card" data-install-card hidden>
        <div>
          <strong>Instalá la app</strong>
          <p data-install-hint>Accedé al clima con un toque, como una app de Android.</p>
        </div>
        <md-filled-button data-install>
          <md-icon slot="icon">download</md-icon>
          Instalar
        </md-filled-button>
      </div>

      <!-- Alertas SMN -->
      <section class="card smn-alerts-card" data-smn-card hidden>
        <div class="smn-alert-head">
          <div class="smn-alert-title-row">
            <span class="smn-alert-badge" data-smn-badge>Alerta SMN</span>
            <span class="smn-alert-title" data-smn-title>--</span>
          </div>
          <span class="smn-alert-source">SMN Oficial</span>
        </div>
        <p class="smn-alert-desc" data-smn-desc></p>
        <div class="smn-alert-instructions" data-smn-instructions hidden></div>
        <div class="smn-alert-foot">
          <span class="smn-alert-time" data-smn-time></span>
          <button type="button" class="smn-alert-toggle-btn" data-smn-toggle hidden>
            <span>Recomendaciones</span>
            <md-icon>expand_more</md-icon>
          </button>
        </div>
      </section>

      <section class="card hero">
        <div class="hero-row">
          <div class="hero-main">
            <div class="temp"><span data-field="temperature">--</span><span class="unit">°C</span></div>
            <p class="feels">Sensación térmica <span data-field="feelsLike">--</span>°</p>
            <p class="station-badge" data-field="stationBadge" hidden>
              <md-icon>cell_tower</md-icon>
              <span data-field="stationBadgeText"></span>
            </p>
          </div>
          <div class="hero-side">
            <div class="hero-icon-wrap" data-field="heroAvatar">
              <md-icon data-field="heroIcon">wb_sunny</md-icon>
            </div>
            <div class="extremes">
              <span><md-icon>arrow_upward</md-icon> Máx <b data-field="temperatureMax">--</b>°</span>
              <span><md-icon>arrow_downward</md-icon> Mín <b data-field="temperatureMin">--</b>°</span>
            </div>
          </div>
        </div>
      </section>

      <section class="card elevated forecast-card">
        <div class="forecast-header">
          <div class="forecast-title-col">
            <div class="forecast-title-row">
              <span class="forecast-badge" data-field="forecastStationBadge">Estación Local</span>
              <h2 class="forecast-title">Pronóstico de la estación</h2>
            </div>
            <span class="forecast-subtitle" data-field="forecastStationSub">Estación ClimaChivilcoy · Barrio Alsina</span>
          </div>
          <span class="forecast-period-badge" data-field="forecastPeriod">--</span>
        </div>
        <div class="forecast-head">
          <div class="forecast-icon-avatar" data-field="forecastAvatar">
            <md-icon data-field="forecastIcon">partly_cloudy_day</md-icon>
          </div>
          <div class="forecast-heading">
            <div class="forecast-condition" data-field="forecastCondition">Sin pronóstico</div>
          </div>
        </div>
        <div class="forecast-details" data-field="forecastDetails"></div>
        <p class="forecast-note">
          <md-icon>cell_tower</md-icon>
          <span data-field="forecastNote">Pronóstico derivado de sensores y modelo meteorológico de la estación ClimaChivilcoy (Barrio Alsina).</span>
        </p>
      </section>

      <section class="card elevated smn-forecast-card" data-smn-forecast-container hidden>
        <div class="smn-forecast-header">
          <div class="smn-forecast-title-col">
            <div class="smn-forecast-title-row">
              <span class="smn-forecast-badge">
                <md-icon>verified</md-icon>
                Oficial SMN
              </span>
              <h2 class="smn-forecast-title">Pronóstico extendido</h2>
            </div>
            <span class="smn-forecast-subtitle">Región Chivilcoy · Próximos 6 días</span>
          </div>
          <span class="smn-forecast-source">
            <md-icon>radar</md-icon>
            <span>SMN Argentina</span>
          </span>
        </div>
        <div class="smn-forecast-list" data-smn-forecast-list></div>
        <p class="smn-forecast-note">
          <md-icon>verified_user</md-icon>
          <span>Pronóstico oficial emitido por el Servicio Meteorológico Nacional (SMN).</span>
        </p>
      </section>

      <section class="card webcam-card" data-webcam-card hidden>
        <div class="webcam-head">
          <div class="metric-head"><md-icon>photo_camera</md-icon> Cámara en vivo</div>
          <div class="webcam-actions">
            <span class="webcam-time" data-field="webcamTime">--</span>
            <md-icon-button data-webcam-refresh aria-label="Actualizar la cámara ahora">
              <md-icon>refresh</md-icon>
            </md-icon-button>
          </div>
        </div>
        <div class="webcam-frame" data-webcam-zoom role="button" tabindex="0" aria-label="Ver la cámara en pantalla completa">
          <img class="webcam-img" data-webcam-img alt="Vista en vivo desde la estación ClimaChivilcoy" />
          <div class="webcam-overlay" data-webcam-loading>
            <md-icon>refresh</md-icon>
          </div>
          <span class="webcam-zoom-hint" aria-hidden="true"><md-icon>fullscreen</md-icon></span>
        </div>
        <p class="webcam-note">
          Cámara de la estación ClimaChivilcoy con lecturas · se actualiza sola cada ~2 min. Tocá la
          imagen para agrandar o el botón para refrescar al instante.
        </p>
      </section>

      <section class="card radar-card" data-radar-card>
        <button type="button" class="radar-card-header" data-radar-toggle aria-expanded="false">
          <div class="radar-head-left">
            <div class="radar-icon-avatar">
              <md-icon>radar</md-icon>
            </div>
            <div class="radar-head-titles">
              <span class="radar-head-title">Radar y Satélite en vivo</span>
              <span class="radar-head-sub">Precipitaciones Doppler y satélite GOES-19</span>
            </div>
          </div>
          <div class="radar-head-right">
            <span class="radar-badge-pill">Ver mapa</span>
            <div class="radar-chevron-box">
              <md-icon class="radar-chevron">expand_more</md-icon>
            </div>
          </div>
        </button>

        <div class="radar-card-body" data-radar-body hidden>
          <div class="radar-controls">
            <label class="radar-select-wrap">
              <span class="radar-select-label">Capa:</span>
              <select class="radar-select" data-radar-layer>
                <option value="rainviewer">🌧️ Radar de lluvia en vivo (Pergamino / Ezeiza / Región)</option>
                <option value="goes19_geocolor">🛰️ Satélite GOES-19 GeoColor (Visible día y noche)</option>
                <option value="goes19_ir">🌡️ Satélite Infrarrojo (Topes nubosos y tormentas)</option>
                <option value="goes19_sandwich">⚡ Satélite Sandwich RGB (Convección severa)</option>
              </select>
            </label>
            <div class="radar-actions">
              <span class="radar-layer-time" data-radar-time>--</span>
              <md-icon-button data-radar-refresh aria-label="Actualizar imagen de radar o satélite">
                <md-icon>refresh</md-icon>
              </md-icon-button>
            </div>
          </div>

          <div class="radar-frame" data-radar-frame>
            <iframe class="radar-iframe" data-radar-iframe title="Radar meteorológico en vivo"></iframe>
            <img class="radar-img" data-radar-img alt="Imagen satelital en tiempo real" hidden />
            <div class="radar-overlay" data-radar-loading>
              <md-icon>refresh</md-icon>
            </div>
            <button type="button" class="radar-fullscreen-btn" data-radar-fullscreen aria-label="Ver en pantalla completa">
              <md-icon>fullscreen</md-icon>
            </button>
          </div>

          <div class="radar-footer">
            <span class="radar-source-note">Fuentes oficiales: SINARAME / SMN (Radares Pergamino y Ezeiza) y NOAA (GOES-19).</span>
            <a class="radar-link-btn" href="https://www.smn.gob.ar/radar" target="_blank" rel="noopener noreferrer">
              <span>Sitio oficial de radares SMN</span>
              <md-icon>open_in_new</md-icon>
            </a>
          </div>
        </div>
      </section>

      <section class="grid">
        <article class="card metric">
          <div class="metric-head"><md-icon>humidity_high</md-icon> Humedad</div>
          <div class="metric-value"><span data-field="humidity">--</span><small>%</small></div>
          <div class="metric-sub">Máx <span data-field="humidityMax">--</span>% · Mín <span data-field="humidityMin">--</span>%</div>
        </article>
        <article class="card metric">
          <div class="metric-head"><md-icon>water_drop</md-icon> Punto de rocío</div>
          <div class="metric-value"><span data-field="dewpoint">--</span><small>°C</small></div>
          <div class="metric-sub" data-field="dewpointTrend">--</div>
        </article>
        <article class="card metric">
          <div class="metric-head"><md-icon>speed</md-icon> Presión</div>
          <div class="metric-value"><span data-field="pressure">--</span><small>hPa</small></div>
          <div class="metric-sub" data-field="pressureTrend">--</div>
        </article>
        <article class="card metric">
          <div class="metric-head"><md-icon>air</md-icon> Viento</div>
          <div class="metric-value"><span data-field="windAvg">--</span><small>km/h</small></div>
          <div class="metric-sub">Ráfaga <span data-field="windMax">--</span> km/h · Recorrido <span data-field="windRun">--</span> km</div>
        </article>
        <article class="card metric">
          <div class="metric-head"><md-icon>rainy</md-icon> Lluvia hoy</div>
          <div class="metric-value"><span data-field="rainToday">--</span><small>mm</small></div>
          <div class="metric-sub">Mes <span data-field="rainMonth">--</span> mm</div>
        </article>
        <article class="card metric">
          <div class="metric-head"><md-icon>water</md-icon> Intensidad</div>
          <div class="metric-value"><span data-field="rainRate">--</span><small>mm/h</small></div>
          <div class="metric-sub">Lluvia por hora</div>
        </article>
      </section>

      <section class="stations-section" data-stations-section>
        <div class="stations-header">
          <div class="stations-header-top">
            <div class="metric-head">
              <md-icon>cell_tower</md-icon>
              <span>Estaciones meteorológicas</span>
            </div>
            <div class="stations-badge-pill" data-field="stationsBadgePill">
              <span class="pulse-dot" aria-hidden="true"></span>
              <span data-field="stationsBadgeCount">2 en línea</span>
            </div>
          </div>
          <p class="stations-desc">
            Consultá las lecturas individuales de cada estación local o ingresá a su portal web.
          </p>
        </div>

        <div class="station-selector" role="tablist" aria-label="Selector de estaciones">
          <button type="button" class="station-tab active" data-station-key="chivilcoy" role="tab" aria-selected="true">
            <span class="station-tab-icon">
              <md-icon>cloud</md-icon>
            </span>
            <div class="station-tab-info">
              <span class="station-tab-name">ClimaChivilcoy</span>
              <span class="station-tab-tag">Barrio Alsina</span>
            </div>
            <span class="station-tab-temp" data-station-tab-temp="chivilcoy">--°</span>
          </button>
          <button type="button" class="station-tab" data-station-key="inta" role="tab" aria-selected="false">
            <img src="/img/inta-favicon.ico" width="24" height="24" alt="INTA" />
            <div class="station-tab-info">
              <span class="station-tab-name">INTA Chivilcoy</span>
              <span class="station-tab-tag">Polideportivo Municipal</span>
            </div>
            <span class="station-tab-temp" data-station-tab-temp="inta">--°</span>
          </button>
          <button type="button" class="station-tab" data-station-key="lw6eqg" role="tab" aria-selected="false">
            <img src="/img/lw6eqg-favicon.svg" width="24" height="24" alt="LW6EQG" />
            <div class="station-tab-info">
              <span class="station-tab-name">LW6EQG</span>
              <span class="station-tab-tag">MeteoBridge</span>
            </div>
            <span class="station-tab-temp" data-station-tab-temp="lw6eqg">--°</span>
          </button>
          <button type="button" class="station-tab" data-station-key="ichivi27" role="tab" aria-selected="false">
            <span class="station-tab-icon">
              <md-icon>agriculture</md-icon>
            </span>
            <div class="station-tab-info">
              <span class="station-tab-name">AFA Chivilcoy</span>
              <span class="station-tab-tag">Ruta 30</span>
            </div>
            <span class="station-tab-temp" data-station-tab-temp="ichivi27">--°</span>
          </button>
          <button type="button" class="station-tab" data-station-key="ichivi4" role="tab" aria-selected="false">
            <span class="station-tab-icon">
              <md-icon>south</md-icon>
            </span>
            <div class="station-tab-info">
              <span class="station-tab-name">Zona Sur</span>
              <span class="station-tab-tag">Barrio Sur</span>
            </div>
            <span class="station-tab-temp" data-station-tab-temp="ichivi4">--°</span>
          </button>
        </div>

        <div class="station-status-row">
          <div class="station-selected-meta">
            <span class="station-selected-title" data-station-detail="title">ClimaChivilcoy</span>
            <span class="station-selected-sub" data-station-detail="subtitle">Barrio Alsina · Meteobridge</span>
          </div>
          <div class="station-selected-age" data-station-detail="age">--</div>
        </div>

        <div class="grid station-metrics-grid">
          <article class="card metric">
            <div class="metric-head"><md-icon>thermostat</md-icon> Temperatura</div>
            <div class="metric-value"><span data-station-detail="temp">--</span><small>°C</small></div>
            <div class="metric-sub" data-station-detail="feels">--</div>
          </article>
          <article class="card metric">
            <div class="metric-head"><md-icon>humidity_high</md-icon> Humedad</div>
            <div class="metric-value"><span data-station-detail="humidity">--</span><small>%</small></div>
            <div class="metric-sub" data-station-detail="dewpoint">--</div>
          </article>
          <article class="card metric">
            <div class="metric-head"><md-icon>air</md-icon> Viento</div>
            <div class="metric-value"><span data-station-detail="wind">--</span><small>km/h</small></div>
            <div class="metric-sub" data-station-detail="gust">--</div>
          </article>
          <article class="card metric">
            <div class="metric-head"><md-icon>speed</md-icon> Presión</div>
            <div class="metric-value"><span data-station-detail="pressure">--</span><small>hPa</small></div>
            <div class="metric-sub" data-station-detail="rain">--</div>
          </article>
        </div>

        <div class="station-actions-grid">
          <a class="card station-action-card" data-station-web-btn href="https://climachivilcoy.com.ar/" target="_blank" rel="noopener noreferrer">
            <div class="station-action-left">
              <div class="station-action-avatar" data-station-web-avatar>
                <md-icon>cloud</md-icon>
              </div>
              <div class="station-action-text">
                <span class="station-action-title" data-station-web-title>Sitio oficial de ClimaChivilcoy</span>
                <span class="station-action-url" data-station-web-url>climachivilcoy.com.ar</span>
              </div>
            </div>
            <span class="station-action-pill">
              <span>Abrir web</span>
              <md-icon>open_in_new</md-icon>
            </span>
          </a>

          <a class="card station-action-card" data-station-map-card href="https://www.google.com/maps/search/?api=1&query=-34.903034,-60.002193" target="_blank" rel="noopener noreferrer">
            <div class="station-action-left">
              <div class="station-action-avatar map-avatar">
                <md-icon>location_on</md-icon>
              </div>
              <div class="station-action-text">
                <span class="station-action-title" data-station-map-title>Barrio Alsina (Zona Este)</span>
                <span class="station-action-url" data-station-map-sub>Coordenadas: -34.9030, -60.0022</span>
              </div>
            </div>
            <span class="station-action-pill map-pill">
              <span>Ver en Maps</span>
              <md-icon>open_in_new</md-icon>
            </span>
          </a>
        </div>
      </section>

